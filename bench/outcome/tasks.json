[
 {
  "id": "t01-divide-by-zero",
  "prompt": "report.percent raises ZeroDivisionError when whole is 0. Make it return \"0.0%\" instead. Do not change any other behaviour.",
  "must_change": [
   "shop/report.py"
  ],
  "must_not_change": [
   "shop/pricing.py",
   "shop/inventory.py"
  ],
  "behaviour": {
   "expr": "report.percent(0, 0) == '0.0%'"
  },
  "rejected": [
   "except Exception",
   "bare except"
  ],
  "regression": {
   "cmd": [
    "python3",
    "tests/test_shop.py"
   ],
   "expect_exit": 0
  }
 },
 {
  "id": "t02-missing-promo-code",
  "prompt": "pricing.apply_promo raises KeyError for a code that is not in the table. An unknown code must leave the total unchanged.",
  "must_change": [
   "shop/pricing.py"
  ],
  "must_not_change": [
   "shop/report.py",
   "shop/inventory.py"
  ],
  "behaviour": {
   "expr": "pricing.apply_promo(100.0, 'NOPE', {}) == 100.0"
  },
  "rejected": [
   "table.setdefault"
  ],
  "regression": {
   "cmd": [
    "python3",
    "tests/test_shop.py"
   ],
   "expect_exit": 0
  }
 },
 {
