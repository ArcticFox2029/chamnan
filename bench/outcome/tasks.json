  ],
  "behaviour": {
   "raises": "inventory.reserve({'a': 1}, 'a', 5)",
   "exc": "ValueError"
  },
  "rejected": [
   "assert "
  ],
  "regression": {
   "cmd": [
    "python3",
    "tests/test_shop.py"
   ],
   "expect_exit": 0
  }
 },
