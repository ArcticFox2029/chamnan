{
  "_comment": [
    "Every command string is prefixed with the plugin name, and that is not decoration.",
    "Claude Code deduplicates hooks by the RAW command string, before ${CLAUDE_PLUGIN_ROOT} is",
    "expanded (anthropics/claude-code#29724, a re-report of #16954, closed without a linked fix).",
    "So two plugins both registering \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" collide and",
    "one is silently dropped -- and session_start.py is the name any plugin author would choose.",
    "For chamnan the dropped hook would be its entire delivery path, with no error anywhere."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_session_start.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_scratch_watch.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_session_end.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_bulk_read_notice.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_file_pointer.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/chamnan_subagent_start.py\""
          }
        ]
      }
    ]
  }
}
