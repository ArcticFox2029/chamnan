#!/usr/bin/env python3
"""chamnan-map — build .chamnan/MAP.md from the repository's source, and report what it cost.

The map exists so an agent can answer "which file do I open for X" without reading or grepping the
tree. Measured across three real repositories (Python, JS+shell, mixed), the Quick Index came to
0.3-3.1% of the source it indexes, and answered 6 of 6 navigation questions on its own.

The coverage number printed at the end is not decoration. The index is built from each file's
opening comment, so a repository that does not write them gets an index of filenames and function
counts, which is worth far less. Reporting coverage tells the user which lever to pull.
"""
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))

import assets as assets_mod  # noqa: E402
import mapper  # noqa: E402
import tree  # noqa: E402
import rollup  # noqa: E402
import tokens  # noqa: E402
import workspace as ws  # noqa: E402
import redact  # noqa: E402

# Every `bin/` command shadows print with the scrubbing emitter, whether or not its output looks
# like it could carry a secret today. Five findings running came from one store having a guarded
# reader and an unguarded one, and the case-by-case judgement about which commands "only print
# numbers" is exactly the judgement that was wrong each time. Uniform is cheaper to keep true than
# correct-per-file. See redact.emit.
print = redact.emit  # noqa: A001


def coverage(files):
    """Counts only files that could carry a summary — see mapper.scan's `describable`."""
    countable = [f for f in files if f.get("describable", True)]
    return len([f for f in countable if f["doc"]]), len(countable)


HOOK_MARKER = "# >>> chamnan"
HOOK_BODY = """{marker}
# Keeps .chamnan/MAP.md in step with the code. A stale index is worse than none: it is confidently
# wrong, and the next session believes it. Never fails a commit — if chamnan errors, the commit
# proceeds and the index is simply not refreshed.
if command -v chamnan-map >/dev/null 2>&1; then
  if ! git diff --cached --quiet --diff-filter=ACDR 2>/dev/null; then
    chamnan-map >/dev/null 2>&1 || true
    git add .chamnan/MAP.md >/dev/null 2>&1 || true
  fi
fi
# <<< chamnan
"""


def preview(root, explain=False):
    """What the session-start hook would inject right now, or what each part of it cost.

    `--explain` answers the question the injection could not answer about itself: why is this in my
    context, and what is it costing? Every budget decision was an argument before there was a
    number to point at. The hook itself does the accounting, as a side effect of building the text,
    so there is no second model of the injection that can drift out of step with the real one.
    """
    hook = HERE.parent / "hooks" / "chamnan_session_start.py"
    if not hook.is_file():
        print("chamnan: chamnan_session_start.py not found beside this command", file=sys.stderr)
        return 1
    args = [sys.executable, str(hook)] + (["--explain"] if explain else [])
    # The only subprocess call in this package that had no timeout, no exception handling and no
    # returncode check. All three matter for the same reason: this command exists to tell someone
    # what their session receives, so a hook that hangs, crashes or exits non-zero must be reported
    # as that rather than as an empty index. Before this, a hook that crashed before printing
    # produced "nothing to inject yet — run chamnan-map first", which is the wrong diagnosis and
    # sends a debugging reader in the wrong direction.
    try:
        out = subprocess.run(args, input="{}", capture_output=True, text=True,
                             errors="replace", cwd=root, timeout=120)
    except subprocess.TimeoutExpired:
        print("chamnan: the session-start hook did not finish within 120s", file=sys.stderr)
        return 1
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"chamnan: could not run the session-start hook — {exc}", file=sys.stderr)
        return 1
    if out.returncode != 0:
        print(f"chamnan: the session-start hook exited {out.returncode}", file=sys.stderr)
        if out.stderr.strip():
            print(out.stderr.rstrip(), file=sys.stderr)
        return 1
    if explain:
        print(out.stdout.rstrip() or "chamnan: nothing is injected in this repository yet")
        return 0
    body = out.stdout.strip()
    if not body:
        print("chamnan: nothing to inject yet — run chamnan-map first")
        return 0
    print(body)
    print(f"\n---\n[{tokens.estimate(body):,.0f} tokens. This is what every session in this repo")
    print("receives automatically once the plugin is loaded.]")
    return 0


def _hooks_dir(root):
    """Where git will ACTUALLY look for hooks, which is not always `.git/hooks`.

    Two states break the obvious guess, and both are ordinary rather than exotic:

    `core.hooksPath` relocates hooks entirely — pre-commit, Husky and lefthook all set it. A hook
    written to `.git/hooks/pre-commit` in such a repository is a **dead file**: git runs the other
    directory, the commit succeeds, and nothing reports that the hook installed a moment ago will
    never fire.

    And in a **worktree**, `.git` is a *file* containing `gitdir: …`, not a directory. Testing
    `(root / ".git").is_dir()` calls a perfectly good repository "not a git repository" and refuses
    to install at all.

    `git rev-parse --git-path hooks` resolves both, and returns the shared hooks directory for a
    worktree, which is where hooks actually live.
    """
    try:
        out = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-path", "hooks"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode == 0 and out.stdout.strip():
            p = Path(out.stdout.strip())
            return p if p.is_absolute() else (root / p)
    except (OSError, subprocess.SubprocessError):
        pass
    return None


_UNREACHABLE_TAIL = re.compile(r"^\s*exit\s+\d*\s*$")


def _ends_unreachable(script):
    """True when the last thing this script does is exit unconditionally.

    Read from the end backwards over blanks and comments only. An `exit 0` inside an `if` or a
    function is not the end of the script, and treating it as one would refuse a hook that is
    perfectly fine to append to.
    """
    for line in reversed(script.splitlines()):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        return bool(_UNREACHABLE_TAIL.match(line))
    return False


def _show(path, root):
    """A path to print. Relative when it is inside the repository, absolute when it is not.

    🐛 `relative_to(root)` raised ValueError on exactly the paths _hooks_dir goes out of its way to
    resolve OUTSIDE the root — a `git worktree` checkout, where hooks live in the main checkout,
    and any repository with `core.hooksPath` set (husky, lefthook, pre-commit). The install had
    already succeeded and written the file; the user got a traceback and exit 1, and the second
    run crashed on the "already installed" path too.
    #
    And the same call hid a different bug in the map line: printing the output path relative made
    `chamnan-map` look like it had rebuilt the repository the session was told about, when run from
    inside a nested checkout it had rebuilt that checkout's own map instead — so the staleness
    warning never cleared and the advice looked broken.
    """
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def install_git_hook(root):
    """Opt-in only, and never destructive to a hook the user already has."""
    hooks = _hooks_dir(root)
    if hooks is None:
        print("chamnan: not a git repository — nothing to install into", file=sys.stderr)
        return 1
    hooks.mkdir(parents=True, exist_ok=True)
    target = hooks / "pre-commit"
    body = HOOK_BODY.format(marker=HOOK_MARKER)
    if target.exists():
        existing = target.read_text(encoding="utf-8", errors="replace")
        if HOOK_MARKER in existing:
            print(f"chamnan: already installed in {_show(target, root)}")
            return 0
        # A hook that ends in `exit 0` -- a common way to write one -- makes everything appended
        # after it dead shell code. The install said "the index now refreshes on every commit"
        # and it never ran once, which is the stale index the README warns is worse than none.
        # Refused rather than worked around: prepending would change when the user's own hook
        # runs, and editing their script is not this tool's call to make.
        if _ends_unreachable(existing):
            print(f"chamnan: {_show(target, root)} ends in an unconditional `exit`, so "
                  f"anything appended after it would never run.", file=sys.stderr)
            print("  Add this line yourself, above that exit:", file=sys.stderr)
            print("    command -v chamnan-map >/dev/null 2>&1 && chamnan-map >/dev/null 2>&1 || true",
                  file=sys.stderr)
            return 1
        target.write_text(existing.rstrip() + "\n\n" + body, encoding="utf-8")
        print(f"chamnan: appended to your existing {_show(target, root)}")
    else:
        target.write_text("#!/bin/sh\n\n" + body, encoding="utf-8")
        target.chmod(0o755)
        print(f"chamnan: installed {_show(target, root)}")
    print("  The index now refreshes on every commit that touches tracked files.")
    # 🎯 Said at install time because it is the only moment the user is making this choice, and
    # because the rebuild is a FULL rescan with no incremental path — on tinygrad, 1,032 source
    # files, it measured 107 seconds, and this hook runs it in the foreground, so every commit that
    # adds, deletes or renames a file waits for it. Nobody discovers that until their first commit
    # hangs, by which point the cause is three steps away from the symptom.
    #
    # A count and a measured comparison, not an estimate in seconds: extrapolating a duration from
    # a file count would be a guess presented as a fact, which is the failure this project keeps
    # finding in its own output. The walk costs about 0.04s on 1,478 files, so saying it is free.
    try:
        import tree as _tree
        with _tree.session():
            n = sum(1 for _ in mapper.indexable(root))
        if n >= 300:
            print(f"  Note: rebuilding is a full rescan of all {n:,} source files, and this hook "
                  f"runs it in the FOREGROUND — every commit that adds, deletes or renames a file "
                  f"waits for it. For scale: a 1,032-file tree measured 107 seconds.")
            print("  On a tree this size you may prefer to run `chamnan-map` by hand instead.")
    except Exception:
        pass          # a nicety; never the reason an install fails
    print(f"  Remove it by deleting the block marked '{HOOK_MARKER}'.")
    return 0


KNOWN_FLAGS = ("--install-git-hook", "--explain", "--preview", "--measure", "-h", "--help")


def main(argv):
    # 🐛 There was no `--help`, and this command treats any non-flag argument as a directory to
    # scan — so `chamnan-map --help` fell through and REBUILT THE MAP. It writes MAP.md, so the
    # most cautious thing a new user can type performed a write. Found by an agent that typed it
    # by reflex in the wrong directory and rewrote a real repository's index.
    #
    # An unknown flag is refused rather than ignored for the same reason the README already warns
    # about: a misspelt flag used to be dropped in silence and the command did something other than
    # what was asked, with nothing on screen to say so.
    if any(a in ("-h", "--help") for a in argv):
        print(__doc__.strip() if __doc__ else "chamnan-map — rebuild .chamnan/MAP.md")
        return 0
    unknown = [a for a in argv if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        print(f"chamnan-map: unknown flag {unknown[0]} — try --help", file=sys.stderr)
        return 2

    root = ws.find_root()
    if "--install-git-hook" in argv:
        return install_git_hook(root)
    if "--explain" in argv:
        return preview(root, explain=True)
    if "--preview" in argv:
        # Prints exactly what a session would be handed. The hook does this automatically at
        # session start, but a session that has just installed the plugin has not had one yet, and
        # waiting for a restart to see whether the thing works at all is a poor first impression.
        # Reading this is not a simulation of the feature — it IS the content the hook injects.
        return preview(root)
    targets = [Path(a).resolve() for a in argv if not a.startswith("-")]
    if not targets:
        targets = [root]
    # Checked BEFORE anything is walked. `chamnan-map /etc` used to read its way through /etc --
    # a directory it has no business in -- and only then die on the relative_to() below with a
    # traceback, having already spent the time and touched the files.
    outside = [t for t in targets if t != root and root not in t.parents]
    if outside:
        for t in outside:
            print(f"chamnan: {t} is not inside {root} — the index only covers this repository",
                  file=sys.stderr)
        return 2
    missing = [t for t in targets if not t.exists()]
    if missing:
        for t in missing:
            print(f"chamnan: no such path: {t}", file=sys.stderr)
        return 2
    # Silently ignoring the second path was worse than refusing it: `chamnan-map src game` looked
    # like it had indexed both and indexed only src, so the map was wrong in a way nothing showed.
    target = targets[0]
    if not ws.enabled("map", root):
        print("chamnan: map is disabled in .chamnan/config.json")
        return 0
    ws.prune_logs(root)
    ws.prune_sessions(root)
    files = []
    seen_paths = set()
    # Once per run, not once per target — scan() no longer clears these itself, because doing so
    # made `chamnan-map <a> <b>` report only the last target's skipped files. See mapper.reset_skips.
    mapper.reset_skips()
    for one in targets:
        for f in mapper.scan(one):
            # Paths are made relative to the repo root so several scanned directories share one
            # namespace instead of each restarting from its own root.
            rel = str((one / f["path"]).relative_to(root))
            if rel in seen_paths:
                continue
            seen_paths.add(rel)
            f["path"] = rel
            files.append(f)
    files.sort(key=lambda f: f["path"])
    if not files:
        print(f"chamnan: no recognised source files under {target}", file=sys.stderr)
        return 1
    text = mapper.render(files, root)
    try:
        out = ws.ensure(root) / "MAP.md"
    except ws.NotAWorkspace as err:
        print(f"chamnan: {err}", file=sys.stderr)
        return 1
    # 🐛 Was a plain write_text, which truncates the file and then fills it — so an interrupted run
    # leaves a MAP.md that is HALF AN INDEX, and the session-start hook injects it as a complete
    # one. Reproduced with `ulimit -f 8`: the header still said "41 source file(s)", 31 rows were
    # present, the last was the two characters `- **`li`, and ten files including lib/workspace.py
    # were simply absent. No warning, exit 0. A reader looping on the file during a rebuild also
    # caught 8 zero-byte reads in 85,934, because the truncation is a window of its own.
    #
    # Every other shared-file writer in this project already does this — pointer.py writes beside
    # the target and replaces, tools_index.py does the same under a lock, and their comments say
    # why. MAP.md is the largest and most load-bearing artefact in the workspace and was the one
    # doing neither.
    #
    # Beside the target, never in the system temp directory: os.replace fails with EXDEV across
    # mount points, and a copy-and-delete fallback would give up the atomicity this exists for.
    # 🐛 `out.with_suffix(".md.tmp")` is the same path in every process. Reproduced with two
    # concurrent rebuilds: two of three runs produced a MAP.md carrying content from BOTH builds
    # interleaved, and the losing process exited 0 having installed the corrupted file. The
    # `os.replace` was never the problem; the shared staging name is.
    try:
        if not ws.atomic_write_text(out, text):
            raise OSError(f"could not write {out}")
    except OSError as err:
        # 🐛 The first version of this fix fell back to `out.write_text(text)` here, "so a failed
        # run does not lose its output" — and the fixture caught it in one run: the fallback hit
        # the same limit and truncated the GOOD index from 4,712 bytes to 4,096. Losing this run's
        # output is the correct outcome; destroying the index that was already there is not.
        #
        # No `tmp.unlink()` here any more: the staging file belongs to `ws.atomic_write_text`, which
        # removes its own on failure. Leaving the old cleanup behind raised NameError from inside an
        # `except OSError`, so an interrupted rebuild died with a traceback instead of the sentence
        # this branch exists to print — the failure path's own failure path.
        print(f"chamnan: could not write the index ({err.__class__.__name__}: {err}).",
              file=sys.stderr)
        print(f"  The existing {out.name} is unchanged.", file=sys.stderr)
        return 1

    src = sum(f["tokens"] for f in files)
    index_chars = text.index("## Full Detail")
    index_tokens = tokens.estimate(text[:index_chars])
    detail_tokens = tokens.estimate(text[index_chars:])
    have, total = coverage(files)
    pct = have / total * 100 if total else 0
    if targets == [root]:
        scope = ""
    else:
        names = ", ".join(str(x.relative_to(root)) for x in targets)
        scope = f"  (scanned {names})"
    # Say which repository was measured whenever that is not the directory the command was run in.
    # Silent is the dangerous default here: find_root walks up for a VCS marker, so running this
    # inside a folder that is not itself a repository measures whatever repository contains it, and
    # every number printed below is about the wrong tree. Hit for real -- a corpus was benchmarked
    # in place, before it had a .git of its own, and quietly reported its host's figures.
    here = Path.cwd().resolve()
    if root.resolve() != here:
        try:
            where = here.relative_to(root)
            print(f"chamnan: run from {where}/ — scanning the repository above it, {root.name}/")
        except ValueError:
            print(f"chamnan: scanning {root}")
    print(f"chamnan-map -> {_show(out, root)}{scope}")
    # len(files), not `total`. `total` is the DESCRIBABLE subset -- the denominator of the coverage
    # bar two lines down -- and printing it here labelled "source file(s)" put two different
    # populations on one line: a file count that excluded the undescribable files beside a token
    # count that included them. It also disagreed with the header chamnan writes into MAP.md, which
    # has always used len(files), so the tool and its own artifact reported different sizes for the
    # same scan. Caught by reading both at once on a real repository: 187 printed, 189 in the file.
    print(f"  {len(files)} source file(s), {src:,.0f} tokens of code")
    # Said out loud because the silence was the indefensible half of the defect this reports.
    # coveragepy's index was built without `coverage/` -- the shipped library, 29% of the repo --
    # and the run said nothing at all, so the only visible number was a coverage bar computed over
    # what survived. A directory named like build output is still usually build output, so this
    # does not warn; it states what was left out and how to disagree with it.
    # Said, not silent — same reasoning as the line below it. A file the repository itself declares
    # machine-written is the one exclusion a reader can check against a file they can open.
    # 🐛 Three ways a file could vanish from the index while the run reported full confidence.
    # SKIPPED_TOO_LARGE and SKIPPED_BINARY were recorded with a comment saying "Recorded, not
    # merely skipped … false confidence rather than degraded confidence, which is the worse kind"
    # — and then read by nothing but one test. Measured on azadkuh/sqlite-amalgamation: sqlite3.c
    # is 8.5 MB, 71% of the repository and the reason it exists, absent from the index, with
    # "described 3/3 files (100%)" printed beneath. The nested-checkout exclusion is correct but
    # equally unannounced, so a submodule superproject's map is its glue file and nothing else.
    if mapper.SKIPPED_TOO_LARGE:
        _big = ", ".join(f"{p.name} ({assets_mod._human(sz) if isinstance(sz, int) else sz})"
                        for p, sz in mapper.SKIPPED_TOO_LARGE[:4])
        _more = len(mapper.SKIPPED_TOO_LARGE) - 4
        print(f"  not indexed, over the size limit: {_big}" + (f" +{_more} more" if _more > 0 else ""))
    if mapper.SKIPPED_BINARY:
        print(f"  not indexed, binary content behind a source extension: "
              f"{len(mapper.SKIPPED_BINARY)} file(s)")
    if getattr(tree, "UNREADABLE", None):
        _un = ", ".join(sorted(tree.UNREADABLE)[:4])
        print(f"  COULD NOT BE READ, so the counts below exclude them: {_un}")
    if mapper.SKIPPED_GENERATED:
        print(f"  not indexed, declared linguist-generated in .gitattributes: "
              f"{len(mapper.SKIPPED_GENERATED)} file(s)")
    if mapper.SKIPPED_BUILD_DIR:
        named = ", ".join(sorted(mapper.SKIPPED_BUILD_DIR)[:6])
        more = len(mapper.SKIPPED_BUILD_DIR) - 6
        print(f"  not indexed, read as build output: {named}" + (f" +{more} more" if more > 0 else ""))
    # 🐛 An extension chamnan cannot read was the one skip reason that said nothing. Measured on
    # Svelte's own monorepo: 4,540 `.svelte` files missing from the index — more than the 3,480 it
    # did index — and the run reported full coverage of what it saw.
    #
    # Reported only when the count is comparable to what WAS indexed: every repository is full of
    # `.json`, `.lock` and `.png` that nobody expects an index to cover, and a line naming all of
    # them is noise that teaches the reader to skip this whole block. A tenth of the indexed count,
    # or fifty files, is the point at which "chamnan cannot read your main language" becomes the
    # likelier reading.
    _unknown = [(ext, n) for ext, n in mapper.SKIPPED_UNKNOWN_EXT.most_common()
                if n >= max(50, len(files) // 10)]
    if _unknown:
        _named = ", ".join(f"{n:,} {ext}" for ext, n in _unknown[:3])
        print(f"  not indexed, no reader for the extension: {_named}")
        print("    chamnan reads the languages in mapper.EXT_LANG; these are not among them.")
        print("  (git-tracked directories with these names ARE indexed; these are not tracked)")
    # 🐛 ZeroDivisionError when the scan finds no code -- a namespace package of empty
    # `__init__.py`, or any tree whose files are all empty. It crashed at this line, which is
    # AFTER MAP.md has already been overwritten, so the user's index was replaced and the report
    # that would have explained it never printed. `chamnan-map` is the first thing
    # `/chamnan:bootstrap` runs.
    # 🐛 On a small repository this printed things like "1150.6% of the source" — true, and the
    # first number a new user sees from `/chamnan:bootstrap`, where it reads as a malfunction. The
    # README already says plainly that on a four-file repository this costs more than it saves;
    # the tool should say the same thing in the same words rather than as a percentage nobody can
    # act on. Above 100% the ratio is not a saving at all, so it stops being reported as one.
    if not src:
        share = "no code to compare against"
    elif index_tokens >= src:
        share = "larger than the source — this repository is too small for an index to pay"
    else:
        share = f"{index_tokens / src * 100:.1f}% of the source"
    print(f"  Quick Index  {index_tokens:>8,.0f} tokens  ({share})")
    print(f"  Full Detail  {detail_tokens:>8,.0f} tokens  (grep this, never read it whole)")
    bar = "#" * int(pct / 5) + "." * (20 - int(pct / 5))
    skipped = len(files) - total
    note = f", {skipped} with no code to describe" if skipped else ""
    print(f"  described    [{bar}] {have}/{total} files ({pct:.0f}%{note})")

    for label, marker in (("data model", "## Data model\n"), ("API surface", "## API surface"),
                          ("config", "## Configuration")):
        if marker in text[:index_chars]:
            print(f"  + {label} section included")

    if mapper.PARSE_WARNINGS:
        print(f"\n  {len(mapper.PARSE_WARNINGS)} file(s) raised a parse warning while being read:")
        for path, count, msg in mapper.PARSE_WARNINGS[:4]:
            rel = path.replace(str(root) + "/", "")
            print(f"    {rel} — {msg}")
        print("  Harmless today; several of these become hard errors in a future Python, and")
        print("  py_compile does not report them, so nothing else in a normal check will.")

    # Two different numbers, and conflating them reads as a problem where there is none: the index
    # WRITTEN here is whatever the repo needs, while the index INJECTED at session start is capped.
    # Saying "over budget" without saying what happens next made a working roll-up look like a
    # warning the user had to act on.
    budget = ws.load_config(root).get("index_token_budget", 3000)
    if index_tokens > budget:
        # `root=None` deliberately, and it is the difference between 1,203 ms and 1 ms here.
        # Passing the root makes `collapse` rank filenames by git churn, which costs one
        # `git log --name-status -M -n 600` — 1.2 s cold on this repository, and it is the ONLY
        # thing in this command that runs git. The ranking decides WHICH filenames survive each
        # directory line, which matters for the index a session receives; this call produces a
        # token count printed to a terminal, and the count is the same either way. Measured:
        # 1,361 tokens churn-ranked against 1,385 alphabetical, a difference of 1.77% in a figure
        # already shown with a `~`.
        rolled = tokens.estimate(rollup.collapse(text[:index_chars], out.name, budget, None))
        print(f"\n  Over the {budget:,}-token session budget, so session start will roll this up by")
        print(f"  directory: ~{rolled:,.0f} tokens injected per session instead of {index_tokens:,.0f},")
        print(f"  with every directory still named and the full entry a grep away in MAP.md.")
        print(f"  For per-file detail in the session instead, either raise index_token_budget or")
        print(f"  narrow the scan: chamnan-map <dir> [<dir> ...]")
    else:
        print(f"\n  Under the {budget:,}-token session budget — injected per session as-is,"
              f" one line per file.")
    if pct < 70:
        # 🐛 A new user with one real file was told to add a comment to a file chamnan itself had
        # installed under `.chamnan/tools/`. Suggesting somebody comment the tool's own
        # scaffolding is advice they cannot act on and would be wrong to.
        #
        # Only the SUGGESTION is filtered, never the index: on a repository that uses
        # `.chamnan/` as a real working directory — which this project's own CLAUDE.md
        # instructs — those files are the owner's work and belong in the map.
        missing = [f["path"] for f in files
                   if not f["doc"] and f.get("describable", True)
                   and not str(f["path"]).startswith(".chamnan/")][:8]
        print(f"\n  {total-have} file(s) have no opening comment, so the index cannot say what they do.")
        print(f"  That is the single biggest lever on this map's usefulness. Missing, for example:")
        for m in missing:
            print(f"    - {m}")
        if ws.enabled("agents", root):
            print(f"  Ask Claude: \"add a one-line opening comment to the files chamnan listed\"")
            print(f"  (/chamnan:bootstrap dispatches a cheap-model agent to do exactly this)")
        else:
            # agents are switched off, so pointing at an agent the user disabled would be noise.
            print(f"  Agents are disabled in .chamnan/config.json, so add these by hand or")
            print(f"  re-enable \"agents\" to have a cheap-model agent write them.")
        lang = ws.load_config(root).get("language", "en")
        if lang == "en":
            print("\n  Those comments will be written in English, which costs fewer tokens for the")
            print("  same meaning and is re-read every session (measured ~1.5x versus Thai, on one")
            print("  tokenizer — not Claude's, so treat it as a direction rather than a figure).")
            print("  If your team would rather read them in another language, that is a fair trade:")
            print("  set \"language\" in .chamnan/config.json, or just tell Claude which to use.")
        else:
            print(f"\n  Comments will be written in: {lang}  (\"language\" in .chamnan/config.json)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
