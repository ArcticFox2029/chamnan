#!/usr/bin/env python3
"""chamnan-promote — turn a one-off script into a tool the repo keeps.

Measured on one developer over 34 days: 2,104 of 17,290 Bash calls (12.2%) wrote a script inline,
and 1,486 distinct paths under /tmp were touched — about 44 throwaway files a day. Most deserve to
be thrown away. The ones that do not are the checks and reports that get re-derived every few days,
each time costing the tokens to think them up again and arriving slightly different, which is worse
than the cost: a regression check that is rewritten each run is not a regression check.

  chamnan-promote <file> <name> [--desc "..."]   install a script as a permanent tool
  chamnan-promote --list                          show what this repo already has
"""
import shutil
import stat
import pathlib
import sys
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import mdblock
import redact
import tools_index  # noqa: E402
import workspace as ws  # noqa: E402
# Every `bin/` command shadows print with the scrubbing emitter, whether or not its output looks
# like it could carry a secret today. Five findings running came from one store having a guarded
# reader and an unguarded one, and the case-by-case judgement about which commands "only print
# numbers" is exactly the judgement that was wrong each time. Uniform is cheaper to keep true than
# correct-per-file. See redact.emit.
print = redact.emit  # noqa: A001


def show(root):
    entries = tools_index.load(root)
    if not entries:
        print("chamnan: no promoted tools yet.")
        print("  When a script proves worth keeping: chamnan-promote <file> <name>")
        return 0
    print(f"chamnan tools — {len(entries)} in {ws.workspace(root).name}/tools/\n")
    # 🐛 Two readers of `tools/index.json`, and only one of them was guarded. The SessionStart hook
    # validates the name, checks the file is really there, and scrubs the description; this reader
    # did none of the three, though it imports `redact` and never called it. The file is committed,
    # so every field is somebody else's text -- and `chamnan-promote --list` is a command an agent
    # runs, which puts its output in a session's context exactly like the block does.
    #
    # Where this DELIBERATELY differs from the hook: the hook drops a broken entry silently, because
    # a session must not be pointed at a tool that is not there. The owner needs the opposite --
    # this is the maintenance command, and an entry hidden here is a stale row they never learn to
    # clean up. So it is reported, marked, and counted, with the name never printed raw.
    broken = 0
    for e in entries:
        # 🐛 A bare string in the array took the whole command down with an AttributeError on
        # `.get`, mid-listing, exit code 1 -- so every entry after it was invisible AND the reader
        # looked like it had crashed rather than found bad data. Found by a test fixture that
        # included the shape the hook already guards against, which is the point of testing the two
        # readers of a store against the same fixture.
        if not isinstance(e, dict):
            broken += 1
            print(f"  {'(not an entry)':<24}   ← not an object; ignored by sessions")
            continue
        used = e.get("runs", 0)
        raw = e.get("name")
        name = ws.safe_tool_name(raw) if isinstance(raw, str) else None
        why = ""
        if name is None:
            # Never the raw field: a path-shaped name is the thing being reported, and printing it
            # as if it were a filename is what makes it look legitimate.
            name, why = "(unusable name)", "  ← not a filename; ignored by sessions"
        else:
            f = ws.workspace(root) / "tools" / name
            if not (f.is_file() and ws.inside(f, root)):
                why = "  ← no such file in tools/; ignored by sessions"
        if why:
            broken += 1
        # A broken entry's description is not printed at all. It is text from a committed file
        # that describes nothing real, so it carries no information the owner needs to find the
        # row -- the name and the reason do that -- while an agent running this command would put
        # it in a session's context. The hook drops such an entry whole for the same reason; this
        # keeps the row visible and drops only the part with nothing to say.
        # 🐛 [2026-09-06] `redact.scrub` removes credentials and `redact.emit` removes control
        # characters, and neither removes a NEWLINE. `tools/index.json` arrives with a clone, so a
        # `desc` holding "x\n  forged-tool.sh   does something trustworthy" printed a second row
        # that reads exactly like a real one, in output an agent and the owner both read directly.
        # The SessionStart hook's reader of this very field already folds it with
        # `mdblock.one_line`; this one, the command a person runs to audit the registry, did not
        # (R12 agent 2).
        desc = "" if why else redact.scrub(mdblock.one_line(
            str(e.get("desc", "") or "(no description)")))
        print(f"  {name:<24} {desc}{why}")
        print(f"  {'':24} added {str(e.get('added','?'))[:10]}, run {used}x")
    if broken:
        print(f"\n  {broken} entr{'y' if broken == 1 else 'ies'} above name nothing this workspace "
              f"has. Sessions skip them; remove them from tools/index.json.")
    return 0


def _origin_for(src, root):
    """Where this tool came from, recorded WITHOUT the machine it came from.

    🐛 [2026-09-04, R15 agent 2] `str(src)` wrote the absolute path, and `tools/index.json` is a
    tracked, committed file. Promoting `~/Desktop/scratch/fix.py` published a home directory and a
    username to everyone who clones -- the same class the repository's own rule names, "never let
    machine-specific paths reach a commit", in a file chamnan writes on the user's behalf.
    Reproduced: the entry read `/private/var/folders/.../probe.py`.

    Nothing derives behaviour from the field; `tools_index.load` carries it through and
    `chamnan-report` prints it. So provenance is kept and the machine is dropped: relative to the
    repository when the source is inside it, and the bare filename when it is not, since a path
    outside the repository means nothing to anyone else reading the file anyway.
    """
    try:
        return src.resolve().relative_to(pathlib.Path(root).resolve()).as_posix()
    except (OSError, ValueError):
        return src.name


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        # Same reason as chamnan-map: this command COPIES a file, so the flag a cautious
        # user tries first must not be the one that does it.
        print(__doc__.strip() if __doc__ else
              "chamnan-promote <file> <name> --desc \"what it does\"")
        return 0
    root = ws.find_root()
    if not ws.enabled("promote", root):
        print("chamnan: promote is disabled in .chamnan/config.json")
        return 0
    if not argv or argv[0] in ("--list", "-l"):
        return show(root)
    if len(argv) < 2:
        # 🐛 [-3] is the blank separator between the two usage lines, so forgetting the second
        # argument printed a single newline to stderr and exited 2. The one command that takes
        # two positional arguments failed with nothing on screen.
        print("\n".join(l for l in __doc__.strip().splitlines()[-3:] if l.strip()),
              file=sys.stderr)
        return 2

    src = Path(argv[0]).expanduser().resolve()
    name = argv[1]
    desc = ""
    if "--desc" in argv:
        i = argv.index("--desc")
        desc = " ".join(argv[i + 1:]).strip()
    if not src.is_file():
        print(f"chamnan: no such file: {src}", file=sys.stderr)
        return 1

    safe = ws.safe_tool_name(name)
    if safe is None:
        print(f"chamnan: {name!r} is not a usable tool name — it has to be a plain filename,\n"
              "  no directory separators, and no leading dot or dash. The registry stores the bare\n"
              "  name, so a path here would leave an entry pointing at a file nothing can find.",
              file=sys.stderr)
        return 2
    try:
        tools = ws.ensure(root) / "tools"
    except ws.NotAWorkspace as err:
        print(f"chamnan: {err}", file=sys.stderr)
        return 1
    dest = tools / (safe if Path(safe).suffix else safe + src.suffix)
    if dest.exists():
        print(f"chamnan: {dest.name} already exists — pick another name or edit it in place",
              file=sys.stderr)
        return 1
    # 🐛 `src` is any path on the machine, and what lands in `.chamnan/tools/` is committed by
    # design — it is deliberately NOT in the workspace's ignore rules. So a private key, a
    # credentials file or an `.env` sitting outside the repository could be copied straight into a
    # git-tracked path, unscrubbed, by one mistyped argument. Reproduced with a test key.
    #
    # The same two gates `peek()` and `catalogs._readable()` already apply before reading a file are
    # applied here before copying one. Refused rather than scrubbed: a tool is source, and silently
    # rewriting somebody's file on the way in would be worse than declining it.
    if redact.is_blocked(src) or redact.is_never_opened(src):
        print(f"chamnan: {src.name} looks like a credential or key file — refusing to copy it into "
              f"a committed directory. Promote a script, not a secret.", file=sys.stderr)
        return 1
    shutil.copy2(src, dest)
    dest.chmod(dest.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    # 🐛 The chmod above says "run this directly" and the line printed below says it too, but a
    # scratch script usually has no shebang — nobody writes one for a file they are about to run
    # with `python3 x.py`. So the promoted tool was marked executable, announced as runnable, and
    # then handed to /bin/sh, which met `import json` and said "command not found". Found by
    # promoting a script this tool had itself asked three times to have promoted.
    #
    # The interpreter is chosen from the SUFFIX rather than guessed from the content: a `.py` file
    # gets `python3`, a `.sh` gets `sh`, and anything else is left exactly as it arrived, because a
    # binary or a language this does not know is not something to prepend a line to.
    _SHEBANG = {".py": "#!/usr/bin/env python3", ".sh": "#!/usr/bin/env sh"}
    _line = _SHEBANG.get(dest.suffix)
    if _line:
        try:
            _body = dest.read_text(encoding="utf-8-sig")
            if not _body.startswith("#!"):
                ws.write_or_raise(dest, _line + "\n" + _body)
        except (OSError, UnicodeDecodeError):
            pass          # unreadable as text: leave it alone rather than corrupt it

    # 🐛 `shutil.copy2` and `chmod` above always succeed before this runs, so a read-only
    # `index.json` (permissions, a read-only mount, disk full) raised OSError HERE, uncaught --
    # a traceback, and the file left on disk: copied, executable, but unregistered. Retrying under
    # the same name then failed forever too, since `dest.exists()` above is checked before any of
    # this runs. Rolled back on failure so the name is free to try again once the real problem
    # (the index file's permissions) is fixed.
    try:
        tools_index.register(root, {
            "name": dest.name, "desc": desc,
            "added": datetime.now().astimezone().isoformat(timespec="seconds"),
            "origin": _origin_for(src, root),
        })
    except OSError as err:
        try:
            dest.unlink()
        except OSError:
            pass
        print(f"chamnan: could not register {dest.name!r} in the tools index: {err}", file=sys.stderr)
        print("  nothing was left behind -- fix the underlying issue (often the index file's "
              "permissions) and run this again.", file=sys.stderr)
        return 1
    rel = dest.relative_to(root).as_posix()
    print(f"chamnan: promoted -> {rel}")
    # Only claim direct execution when the file can actually be executed directly. A promoted file
    # with no shebang and no known suffix is still useful; it is just not a command.
    _runnable = dest.read_bytes()[:2] == b"#!" if dest.is_file() else False
    print(f"  run it with:  {rel}" if _runnable else f"  run it with:  python3 {rel}"
          if dest.suffix == ".py" else f"  run it with:  {rel}")
    if not desc:
        print("  no description given — add one so a future session knows when to reach for it:")
        print(f"    chamnan-promote --list   (then edit {tools_index.path(root).relative_to(root).as_posix()})")
    return 0


if __name__ == "__main__":
    # The copy of the promoted file now raises on a failed write the same way the index
    # registration above already did -- see `workspace.write_or_raise`.
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as _err:
        print(f"chamnan: {_err} — nothing was written", file=sys.stderr)
        sys.exit(1)
