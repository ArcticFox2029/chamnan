#!/usr/bin/env python3
"""chamnan-guard — does anything staged for commit look like a secret or new MCP capability?

  chamnan-guard          scan the staged diff, name the risks, never fail the commit
  chamnan-guard --strict exit 1 instead, for a hook somebody opted into

`lib/redact.py` exists to keep a secret out of everything that reaches the MODEL — the SessionStart
block, `MAP.md`, the file each agent reads. It had never been pointed at the other direction a
secret actually leaves a machine, which is `git commit`, and which is the direction this
repository's own rules name first (R1 agent 5, finding 1).

**It warns. It does not block.** The redactor's own published recall is 98.2% on a synthetic corpus
of deliberately obvious shapes, and it verifies nothing against a live service — by the no-network
rule, and permanently. A false positive that stops every commit is worse than the leak it guards
against: the person turns the hook off, and then nothing is watching at all. `--strict` exists for
somebody who has read that sentence and wants the gate anyway.

**It never prints what it found.** The finding is a file and a line number. Echoing the matched text
would copy the secret into a terminal, a CI log and an agent's transcript — three more places it
now exists — which is the thing this command is for.

Only ADDED lines are read. A removed line is a risk leaving the tree, and a context line is already
committed: flagging either is noise that trains people to ignore the real one.
"""
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import mdblock  # noqa: E402
import redact  # noqa: E402
import workspace as ws  # noqa: E402

# Every `bin/` command shadows print with the scrubbing emitter. This one especially: it is holding
# lines that may BE credentials, and one careless interpolation would print the thing it exists to
# keep out of a terminal.
print = redact.emit  # noqa: A001

KNOWN_FLAGS = ("--strict",)

# A commit is in the foreground of somebody's workflow. The redactor was measured at 32 ms on an
# 18 KB diff, so the cap is not about the scan — it is about a pathological diff (a vendored blob,
# a generated lockfile) turning a commit into a wait. Past this, the scan says what it skipped
# rather than pretending it looked.
MAX_DIFF_BYTES = 4_000_000

# An MCP server entry is executable/network capability, not ordinary configuration. Four items in
# the 2026-09-12 security sweep named different incidents with the same commit-time boundary:
# mcp-remote, MCP Inspector, Git MCP, and model-induced execution through MCP tools. The guard does
# not claim a named package or endpoint is vulnerable -- versions move, and this command does no
# network lookup. It makes a newly staged capability visible for command, version and access review.
#
# Dedicated filenames are the strong signal: every added line matters. Mixed settings files need a
# content signal too, or changing an unrelated editor preference becomes permanent guard noise.
_MCP_CONFIG_NAMES = frozenset((".mcp.json", "mcp.json", "mcp.jsonc"))
_CONFIG_SUFFIXES = (".json", ".jsonc", ".yaml", ".yml", ".toml")
_MCP_SIGNAL = re.compile(
    r"(?:\bmcp[_-]?servers?\b|\bmcp[_-](?:remote|inspector|server|git)\b|"
    r"@modelcontextprotocol/|(?:https?://|wss?://)[^\s\"']*/mcp(?:\b|/))",
    re.I)


def _staged_diff(root):
    """The staged diff, or None when git cannot answer. Never raises.

    `git_can_speak_for` first, and it is not a formality: `git -C <root>` answers about whatever
    repository is ABOVE `root` when `root` itself is not in one. Without it, running this in a
    directory that merely sits inside somebody's checkout would scan THAT repository's staged
    changes and report findings against files this command was never pointed at.
    """
    if not ws.git_can_speak_for(root):
        return None
    try:
        out = subprocess.run(
            [workspace.git_exe(), "-C", str(root), "diff", "--cached", "--no-color", "--no-ext-diff", "-U0"],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            stdin=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def _added_lines(diff):
    """(path, line number, text) for every ADDED line, following the `+++`/`@@` headers.

    The line number is the one in the file after the commit, which is what a person opens. `-U0`
    means every hunk header is followed only by added and removed lines, so the counter needs no
    context handling.
    """
    path, lineno = None, 0
    for raw in diff.splitlines():
        if raw.startswith("+++ "):
            name = raw[4:].strip()
            path = None if name == "/dev/null" else name[2:] if name[:2] in ("a/", "b/") else name
            continue
        if raw.startswith("@@"):
            try:
                after = raw.split("+", 1)[1].split(" ", 1)[0]
                lineno = int(after.split(",", 1)[0])
            except (IndexError, ValueError):
                lineno = 0
            continue
        if raw.startswith("+") and path:
            yield path, lineno, raw[1:]
            lineno += 1


# ------------------------------------------------------ where a dependency comes from, and what
# it runs before anybody reads it
#
# A dependency can arrive from somewhere other than the registry it appears to come from, under a
# name written to be read as a different one, carrying code that runs because it was installed
# rather than because anything imported it. Those are three separate questions and all three are
# answerable from a staged diff, offline, without a list of known-bad names.
#
# Same stance as the MCP signal above: a review signal, never a verdict. Somebody adding a private
# registry on purpose is doing their job, and being told once, at the commit that adds it, costs
# them a second. Being told on every command would cost them the habit of reading it.
#
# Restricted to the files that can actually decide a dependency's origin. A README naming a mirror
# is prose; `.npmrc` naming one is configuration, and the difference is the whole of why this is
# quiet enough to keep — 0 of 2,917 commits across three real repositories.
_SUPPLY_FILES = frozenset((
    ".npmrc", ".yarnrc", ".yarnrc.yml", "pip.conf", "pip.ini", "gemfile", "gemfile.lock",
    "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "composer.json",
    "composer.lock", "cargo.toml", "cargo.lock", "go.mod", "pyproject.toml", "setup.py",
    "setup.cfg", "pipfile", "poetry.lock", "uv.lock", "requirements.txt", "config.toml",
))
_SUPPLY_SUFFIXES = ("requirements.txt", ".gemspec")

# The hosts each ecosystem installs from when nobody has changed anything. Naming them is what
# lets this fire on a REDIRECTION rather than on the existence of a source line -- the first build
# reported `source 'https://rubygems.org'`, which is the official one, written in the one place a
# Ruby project is required to write it. A guard that fires on the correct configuration teaches
# people to ignore it faster than one that never fires at all.
_OFFICIAL_HOSTS = (
    "rubygems.org", "registry.npmjs.org", "registry.yarnpkg.com", "pypi.org", "files.pythonhosted.org",
    "crates.io", "static.crates.io", "index.crates.io", "proxy.golang.org", "sum.golang.org",
    "repo.packagist.org", "packagist.org",
)
# 🐛 `r"\\\\."` here escaped the escape: the alternation became `rubygems\\\\.org`, which matches a
# literal backslash before the dot and therefore nothing, so the lookahead always succeeded and
# every official host was reported as a redirection. Four of twenty cases, all of them the
# "correct configuration is silent" half — the half a guard is judged on.
# 🐛 The separator used to sit OUTSIDE this as `\\s*["\']?`, and `\\s*` can give back what it took:
# the lookahead was then applied at the space after `index-url =`, where the text does not begin
# with a scheme, so it succeeded and `https://pypi.org/simple` was reported as a redirection. The
# whitespace and the quote belong inside the lookahead, where they cannot be surrendered.
_OFFICIAL = "(?!\\s*[\'\\\"]?(?:https?://)?(?:www\\.)?(?:%s))" % "|".join(
    h.replace(".", r"\.") for h in _OFFICIAL_HOSTS)

# 1. THE SOURCE WAS REDIRECTED. A registry line in configuration is the single highest-value thing
#    in this whole file: it changes where every later install comes from, for everyone who clones.
_SUPPLY_SOURCE = re.compile(
    r"(?:^|\s)(?:registry\s*=|@[\w.-]+:registry\s*=|index[-_]url\s*=|extra[-_]index[-_]url\s*=|"
    r"replace-with\s*=|npmRegistryServer\s*:)" + _OFFICIAL +
    r"|\[source\.(?!crates-io\])"
    r"|\bsource\b" + _OFFICIAL + r"\s+[\"']https?://", re.I)

# 2. SOMETHING RUNS AT INSTALL TIME. Code that executes because a package was added, rather than
#    because anything imported it.
#
#    `build.rs` and `extconf.rb` were in the first version and are out: a Rust build script and a
#    Ruby native extension are how those ecosystems build a normal crate or gem, and this only ever
#    sees the repository's OWN manifest -- flagging a project for building itself is pure noise.
_SUPPLY_RUNS = re.compile(
    r"\"(?:preinstall|postinstall|install|prepare|prepublish|prepack)\"\s*:|"
    r"\"(?:post-install-cmd|post-update-cmd|post-autoload-dump)\"\s*:|"
    r"\bcmdclass\s*=", re.I)

# 3. IT DOES NOT COME FROM A REGISTRY AT ALL. A git or path dependency is not wrong -- it is just
#    not something a registry ever reviewed, and a lockfile cannot pin what it does not host.
#
#    🐛 A bare `path = "src/main.rs"` matched, which is a `[[bin]]` target and not a dependency at
#    all. Cargo writes a path DEPENDENCY as an inline table -- `foo = { path = "../foo" }` -- and
#    requiring the brace is what separates the two without needing to know which section we are in.
_SUPPLY_OFF_REGISTRY = re.compile(
    r"(?:\bgit\+|\bgit@|\"github:|\bfile:|\blink:|\{[^}]*\bpath\s*=|"
    r"\"resolved\"\s*:" + _OFFICIAL + r"|"
    r"\bsource\s*=" + _OFFICIAL + r"\s*[\"']https?://)", re.I)

# 4. NOTHING CAN CHECK IT ON ARRIVAL. A lockfile line that pins a version but no digest is a line
#    that cannot detect the file being swapped underneath it.
_SUPPLY_UNVERIFIED = re.compile(r"\"resolved\"\s*:", re.I)
_SUPPLY_VERIFIED = re.compile(r"\"integrity\"\s*:|--hash=|\bsha256\s*=|\bchecksum\s*=", re.I)

# 5. IS IT THE PACKAGE IT LOOKS LIKE? A dependency name written with a Cyrillic `а` or a Greek `ο`
#    reads as the real one and resolves to a different one. This is the same attack `redact` was
#    taught to see in a credential NAME on 2026-09-15 (R13.4, reproducing a Codex CLI issue), and
#    the answer is the same: fold the look-alikes and see whether the name changed. Nothing here
#    needs a list of real package names, which is what makes it work offline and for every
#    ecosystem at once.
#
#    A dependency name is ASCII in all six registries this file knows about, so a non-ASCII letter
#    inside one is worth a line whether or not it is an attack.
_SUPPLY_NAME_CHARS = re.compile(r"[\"'][^\"'\s]*[^\x00-\x7f][^\"'\s]*[\"']\s*:")

# 6. WHAT DOES THE THING THAT RUNS ACTUALLY DO? The install-time hook is the door; this is what
#    walks through it. A script that fetches and executes, decodes a blob and runs it, or spawns a
#    shell is not a build step somebody wrote by accident -- these shapes do not occur in the
#    ordinary `tsc -b` or `python setup.py build_ext` that fills these fields.
_SUPPLY_PAYLOAD = re.compile(
    r"curl[^|&;]*\|\s*(?:ba|z|d|)?sh\b|wget[^|&;]*\|\s*(?:ba|z|d|)?sh\b|"
    r"\bbase64\s+(?:-d|--decode|-D)\b|\batob\s*\(|"
    r"\bchild_process\b|\brequire\s*\(\s*[\"']child_process|"
    r"\beval\s*\(|\bexec\s*\(|\bInvoke-Expression\b|\bpowershell[^\n]*-enc\b|"
    r"\bos\.system\s*\(|\bsubprocess\.(?:call|run|Popen)\s*\(", re.I)


def _looks_like_another_name(text):
    """True when a quoted key in this line reads as one name and is written as another.

    `redact.fold_confusables` maps the look-alike alphabet onto ASCII. If folding changes the line,
    something in it was written with a character chosen to be read as a different one — which for a
    dependency name is the whole of the attack, and for an ordinary manifest never happens.
    """
    try:
        return redact.fold_confusables(text) != text
    except Exception:                        # noqa: BLE001 — a guard must not fail a commit
        return False


_SUPPLY_WHY = (
    ("the source it installs from", _SUPPLY_SOURCE),
    ("code that runs at install time", _SUPPLY_RUNS),
    ("a dependency that no registry hosts", _SUPPLY_OFF_REGISTRY),
    ("a name written with look-alike characters", _SUPPLY_NAME_CHARS),
    ("a script that fetches, decodes or executes", _SUPPLY_PAYLOAD),
)


def scan_supply_changes(diff):
    """`{path: [line numbers]}` for staged lines that change where a dependency comes from.

    Four questions, in the order they matter: was the registry redirected, does something now run
    at install time, does a dependency come from outside any registry, and can what arrives be
    checked against a digest.

    The fourth is asked per FILE rather than per line, because "a resolved URL with no integrity
    field beside it" is a property of the lockfile's shape and a single line cannot answer it.
    """
    found, resolved_at, verified = {}, {}, set()
    for path, lineno, text in _added_lines(diff):
        normal = str(path).replace("\\", "/").casefold()
        name = normal.rsplit("/", 1)[-1]
        if name not in _SUPPLY_FILES and not name.endswith(_SUPPLY_SUFFIXES):
            continue
        if _looks_like_another_name(text):
            found.setdefault(path, []).append(lineno)
            continue
        for _why, pattern in _SUPPLY_WHY:
            if pattern.search(text):
                found.setdefault(path, []).append(lineno)
                break
        if _SUPPLY_VERIFIED.search(text):
            verified.add(path)
        elif _SUPPLY_UNVERIFIED.search(text):
            resolved_at.setdefault(path, []).append(lineno)
    # A lockfile that added resolved URLs and not one digest anywhere.
    for path, lines in resolved_at.items():
        if path not in verified:
            found.setdefault(path, []).extend(lines)
    return {p: sorted(set(v)) for p, v in found.items()}


def scan(diff):
    """`{path: [line numbers]}` for added lines the redactor would have rewritten.

    Asked line by line rather than over the whole diff, because the answer has to name a LINE. The
    redactor is windowed and a whole-document call answers "did anything change" and nothing else,
    which is not a finding somebody can act on.
    """
    found = {}
    for path, lineno, text in _added_lines(diff):
        if not text.strip():
            continue
        if redact.scrub(text) != text:
            found.setdefault(path, []).append(lineno)
    return found


def scan_mcp_changes(diff):
    """`{path: [line numbers]}` for staged lines that add or alter MCP capability.

    This is deliberately a review signal, not a vulnerability verdict. A dedicated MCP file is
    executable configuration whatever spelling its server uses; in a mixed JSON/YAML/TOML file,
    the line must carry an MCP key, a known launcher shape, or an MCP endpoint. Source and prose
    files are outside the set, so documenting an incident does not make every commit noisy.
    """
    found = {}
    for path, lineno, text in _added_lines(diff):
        normal = str(path).replace("\\", "/").casefold()
        name = normal.rsplit("/", 1)[-1]
        dedicated = name in _MCP_CONFIG_NAMES
        config = normal.endswith(_CONFIG_SUFFIXES)
        if dedicated or (config and _MCP_SIGNAL.search(text)):
            found.setdefault(path, []).append(lineno)
    return found


def main(argv):
    if ws.wants_version(argv):
        print(ws.version_line())
        return 0
    if ws.wants_help(argv):
        print(__doc__.strip())
        return 0
    _bad = ws.unknown_flags(argv, KNOWN_FLAGS)
    if _bad:
        print(f"chamnan: unknown option {_bad[0]!r} — {', '.join(KNOWN_FLAGS)}", file=sys.stderr)
        return 2

    strict = "--strict" in argv
    root = ws.find_root()
    diff = _staged_diff(root)
    if diff is None:
        # Not a git repository, or git is not installed. Silence: this runs from a commit hook, and
        # a command that cannot answer must not add a line to somebody's commit output.
        return 0
    if not diff.strip():
        return 0
    if len(diff.encode("utf-8", "replace")) > MAX_DIFF_BYTES:
        print(f"chamnan-guard: staged diff is over {MAX_DIFF_BYTES // 1_000_000} MB — not scanned. "
              f"Run `chamnan-guard` by hand if this commit should be checked.", file=sys.stderr)
        return 0

    found = scan(diff)
    mcp_found = scan_mcp_changes(diff)
    supply_found = scan_supply_changes(diff)
    if not found and not mcp_found and not supply_found:
        return 0

    if found:
        _n = sum(len(v) for v in found.values())
        # This sentence deliberately does not end on a colon. A secret-ish word followed by one
        # reads to chamnan's own redactor as a key introducing a value, so the line was rewritten by
        # it and this file became a NEW hit in the self-scan over the tree chamnan ships.
        print(f"chamnan-guard: {_n} staged line{'s' if _n != 1 else ''} in {len(found)} file"
              f"{'s' if len(found) != 1 else ''} look like a leaked secret", file=sys.stderr)
        for _p in sorted(found)[:6]:
            _lines = found[_p]
            _shown = ", ".join(str(n) for n in _lines[:6]) + (" …" if len(_lines) > 6 else "")
            # The path is repository-authored text on its way to a terminal, like every other value
            # these commands print.
            print(f"    {mdblock.as_quoted(_p, 70)}  line {_shown}", file=sys.stderr)
        if len(found) > 6:
            print(f"    +{len(found) - 6} more file(s)", file=sys.stderr)
        print("  Nothing is printed from those lines on purpose — reading them out would copy the "
              "secret into this terminal and its transcript.", file=sys.stderr)

    if mcp_found:
        _n = sum(len(v) for v in mcp_found.values())
        print(f"chamnan-guard: {_n} staged line{'s' if _n != 1 else ''} in "
              f"{len(mcp_found)} file{'s' if len(mcp_found) != 1 else ''} add or change MCP "
              "execution/network capability", file=sys.stderr)
        for _p in sorted(mcp_found)[:6]:
            _lines = mcp_found[_p]
            _shown = ", ".join(str(n) for n in _lines[:6]) + (" …" if len(_lines) > 6 else "")
            print(f"    {mdblock.as_quoted(_p, 70)}  line {_shown}", file=sys.stderr)
        if len(mcp_found) > 6:
            print(f"    +{len(mcp_found) - 6} more file(s)", file=sys.stderr)
        print("  Review the server command, pinned version, endpoint and granted access. The added "
              "configuration is not printed.", file=sys.stderr)

    if supply_found:
        _n = sum(len(v) for v in supply_found.values())
        print(f"chamnan-guard: {_n} staged line{'s' if _n != 1 else ''} in "
              f"{len(supply_found)} file{'s' if len(supply_found) != 1 else ''} change where a "
              "dependency comes from, or what it runs on arrival", file=sys.stderr)
        for _p in sorted(supply_found)[:6]:
            _lines = supply_found[_p]
            _shown = ", ".join(str(n) for n in _lines[:6]) + (" …" if len(_lines) > 6 else "")
            print(f"    {mdblock.as_quoted(_p, 70)}  line {_shown}", file=sys.stderr)
        if len(supply_found) > 6:
            print(f"    +{len(supply_found) - 6} more file(s)", file=sys.stderr)
        print("  Check the registry it points at, whether an install-time script was added, and "
              "whether what arrives can be verified against a digest. The lines are not printed.",
              file=sys.stderr)

    print("  This is a WARNING and the commit proceeds. `chamnan-guard --strict` fails instead.",
          file=sys.stderr)
    return 1 if strict else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
