#!/usr/bin/env python3
"""chamnan-age — which stored knowledge names a version no environment declares any more.

  chamnan-age            check every memory entry against environments.md

**Never against a clock.** A note written two years ago about a version still in production is
current; one written last month about a version replaced last week is already wrong. Age carries
no information about either, so nothing here reads a date to decide whether knowledge is stale —
it compares what an entry CLAIMS against what `environments.md` declares.

**And it refuses rather than reassures.** The comparison is exactly as good as that file, so a
declared environment nobody has confirmed in six months is not treated as an authority: if every
environment has gone cold, this reports nothing and says so, because "your knowledge is current"
on the strength of a file that has been drifting since January is worse than no check at all —
it is the answer that stops somebody looking.

Nothing is edited. A flagged entry might be perfectly correct history ("we chose this BECAUSE we
were on 13"), and only a person can tell that from a line that has simply gone out of date.
"""
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import aging  # noqa: E402
import workspace as ws  # noqa: E402
# 🐛 `print = redact.emit` scrubs CREDENTIALS and says nothing about control characters, and
# neither of these two commands imported mdblock at all. Every value below is repository-
# authored — an environment heading, a promoted tool name, a path the pointer hook recorded —
# and this is stdout, which is a terminal or an agent's Bash output that becomes transcript.
# The same path value is already wrapped in `one_line` where lib/pointer.py speaks to the
# model; these readers of the same data were missed because four rounds of this sweep named
# `lib/`, `hooks/` and two bin commands by example, and these two were never in the examples
# (R13 agent 3).
import mdblock  # noqa: E402
import redact  # noqa: E402

# Every `bin/` command shadows print with the scrubbing emitter, whether or not its output looks
# like it could carry a secret today. Five findings running came from one store having a guarded
# reader and an unguarded one, and the case-by-case judgement about which commands "only print
# numbers" is exactly the judgement that was wrong each time. Uniform is cheaper to keep true than
# correct-per-file. See redact.emit.
print = redact.emit  # noqa: A001


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    root = ws.find_root()
    if not ws.workspace(root).is_dir():
        print("chamnan: no .chamnan workspace here", file=sys.stderr)
        return 1
    if not ws.enabled("environments", root):
        print("chamnan: environments is disabled in .chamnan/config.json — "
              "aging has nothing to compare against")
        return 0

    findings, unverifiable, refusal = aging.check(root)

    # The refusal is printed INSTEAD of a result, never alongside an empty one: "no findings" and
    # "no check happened" are different answers and must not read the same.
    if refusal:
        # The refusal text names an environment, which is a repository-authored heading.
        print(f"chamnan: not checked — {mdblock.as_quoted(refusal, 200)}")
        return 0

    # 🐛 [2026-09-06] `environments.md`'s own docstring names its central risk — "the oracle has to
    # be maintained, or this reports nothing" — and until now the only thing keeping it honest was
    # somebody re-typing a `Checked:` date. `deploy.scan()` has been extracting the repository's own
    # `name:tag` strings all along for MAP.md, and nothing ever compared the two (R12 agent 5).
    # A date proves a person looked once; a manifest disagreeing proves the content is wrong now.
    #
    # Printed FIRST, because it is the strongest of the three signals here, and worded as a
    # question: a Compose file may be for local development and a Helm override is invisible to a
    # static scan, so what this can honestly say is that two things in this repository disagree.
    drift = aging.deploy_drift(root)
    if drift:
        one = len(drift) == 1
        print(f"{len(drift)} declared version{'' if one else 's'} disagree"
              f"{'s' if one else ''} with this repository's own deployment manifests\n")
        for name, env, declared, seen in drift:
            print(f"  {mdblock.as_quoted(name, 40)}")
            print(f"    environments.md says {mdblock.as_quoted(env, 40)} "
                  f"{mdblock.as_quoted(declared, 24)} · the manifests say "
                  f"{mdblock.as_quoted(seen, 60)}")
        print("\n  Worth a look, not a verdict: a manifest can be for local development, and a "
              "Helm\n  override is invisible to a static scan. Nothing is edited either way.")
        if findings or unverifiable:
            print()

    if not findings and not unverifiable:
        if drift:
            return 0
        # 🐛 [2026-09-06] This read as a completeness claim the check cannot make. Every fresh
        # environment's declared versions are pooled, so a claim matching ANY of them is cleared --
        # and a note explicitly about the environment that DID move on is cleared by an unrelated
        # one that happens to still run the old version. That pooling is deliberate (two
        # environments legitimately differ, which is why environments.md exists) and this module
        # has no way to read which environment a sentence is about. So the sentence says what was
        # actually checked (R11 agent 3).
        print("chamnan: every version named in stored knowledge is still declared by some "
              "environment")
        print("  This does not read which environment an entry is ABOUT: a note about one that "
              "moved on\n  is cleared by another that still runs the old version.")
        return 0

    if findings:
        one = len(findings) == 1
        print(f"{len(findings)} entr{'y' if one else 'ies'} name{'s' if one else ''} a version "
              f"no environment declares\n")
        for category, name, subject, claimed, declared in findings:
            where = ", ".join(f"{mdblock.as_quoted(env, 40)} {mdblock.as_quoted(ver, 24)}"
                              for env, ver in declared) or "nothing"
            print(f"  memory/{mdblock.as_quoted(category, 30)}/{mdblock.as_quoted(name, 60)}")
            print(f"    says {mdblock.as_quoted(subject, 40)} "
                  f"{mdblock.as_quoted(claimed, 30)} · declared: {where}")
        print("\n  Nothing is edited. An entry can name an old version correctly — "
              "\"we chose this BECAUSE we were on 13\" is history, not a mistake.")
        print("  Fix the entry, or `chamnan-env set <name> --versions \"…\"` if the "
              "declaration is what drifted.")

    if unverifiable:
        if findings:
            print()
        print(f"{len(unverifiable)} could not be checked — the only environment declaring that "
              f"version has gone cold\n")
        for category, name, subject, claimed, cold in unverifiable:
            print(f"  memory/{mdblock.as_quoted(category, 30)}/{mdblock.as_quoted(name, 60)}")
            print(f"    says {mdblock.as_quoted(subject, 40)} {mdblock.as_quoted(claimed, 30)}"
                  f" · only {mdblock.as_quoted(cold, 40)} declares it, and it is unconfirmed")
        print("\n  `chamnan-env check` says what to re-confirm; these are not findings, "
              "they are unknowns.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
