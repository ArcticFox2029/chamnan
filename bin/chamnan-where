#!/usr/bin/env python3
"""chamnan-where — every place a name is actually used, not every line that mentions it.

  chamnan-where whole_graphemes        the references, by file and line

The tool for this repository's most-recorded defect: a fix applied to one member of a set and
forgotten in the identical ones beside it. A plain text search gives every line that contains the
name -- the docstring, the import, a string literal, a comment, a method of the same name, a local
variable that shadows it -- and the ones that matter are somewhere in that list.

**Exact for Python, lexical for twenty more, and every answer says which.** Python has a parser.
The others get their comments and string literals removed and then a word-boundary match, which is
not a parser and is measurably better than a text search: 34.6% of a text search's lines on a
530-file, 21-language corpus were comment or string text. Interpolated code is kept, because
`"${target()}"` is a real use. Files it could not judge are COUNTED, because a silent omission is
how a partial answer becomes a wrong one.

🐛 [2026-09-22] (self-measured) A `--grep` flag printed the same query's plain-text hit count beside
the answer, which made the difference vivid. It is gone: the README tells an auditor that this
package runs `git` and this interpreter and nothing else, and that sentence is worth more than a
demonstration. The comparison belongs in a release note, where it costs no promise.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import redact  # noqa: E402
import refs  # noqa: E402
import workspace as ws  # noqa: E402

# Shadowed rather than called at each site: a missed scrub is silent, and this prints repository
# paths and symbol names straight into what becomes an agent's transcript. See redact.emit.
print = redact.emit  # noqa: A001

KNOWN_FLAGS = ()
TAKES_VALUE = ()
TAKES_REST = ()


def _scope(how):
    """One sentence saying how the answer was reached, in the reader's terms rather than ours."""
    exact, lex = how.get("exact", 0), how.get("lexical", 0)
    if lex and exact:
        return (f"{exact} Python file(s) read by a parser; {lex} file(s) in other languages by a "
                f"lexical scan — comments and strings excluded, declarations not distinguished.")
    if lex:
        return (f"{lex} file(s) read by a lexical scan — comments and strings excluded, "
                f"declarations not distinguished. Not a parser.")
    return f"{exact} Python file(s), read by a parser."


def main(argv):
    if ws.wants_version(argv):
        print(ws.version_line())
        return 0
    if not argv or ws.wants_help(argv):
        print(__doc__.strip())
        return 0 if argv else 2

    bad = ws.unknown_flags(argv, KNOWN_FLAGS, TAKES_VALUE, TAKES_REST)
    if bad:
        print(f"chamnan-where: unknown flag {bad[0]} — try --help", file=sys.stderr)
        return 2

    symbol = argv[0]
    root = ws.find_root() or Path(os.getcwd())
    hits, unjudged, how = refs.find(root, symbol)
    # Which method reached the answer is part of the answer, and it is said whether or not anything
    # was found: "no use, and every file was read by a parser" and "no use, and 400 files were read
    # by a scanner that cannot see through a heredoc" are different claims.
    scope = _scope(how)
    if not hits:
        print(f"chamnan: no use of `{symbol}` under {Path(root).name}/. {scope}")
        if unjudged:
            print(f"  {unjudged} file(s) could not be judged, so this is not a proof of absence.")
        return 0

    by_kind = {}
    for rel, line, kind in hits:
        by_kind.setdefault(kind, []).append(f"{rel}:{line}")
    print(f"chamnan: {len(hits)} use(s) of `{symbol}`")
    # `use` last and named for what it is: the lexical scanner cannot tell a declaration from a
    # call, and printing one under "call" would send a reader looking for a caller.
    for kind in ("def", "call", "attribute", "use"):
        for one in by_kind.get(kind, []):
            print(f"  {kind:9} {one}")
    print(f"  {scope}")
    if unjudged:
        print(f"  ({unjudged} file(s) too large or unparseable — not judged, not absent)")
    return 0


if __name__ == "__main__":
    sys.exit(ws.never_fail(lambda: main(sys.argv[1:])))
