#!/usr/bin/env python3
"""chamnan-where — every place a name is actually used, not every line that mentions it.

  chamnan-where whole_graphemes        the references, by file and line

The tool for this repository's most-recorded defect: a fix applied to one member of a set and
forgotten in the identical ones beside it. A plain text search gives every line that contains the
name -- the docstring, the import, a string literal, a comment, a method of the same name, a local
variable that shadows it -- and the ones that matter are somewhere in that list.

**Python only, and it says so.** A declaration has a fixed shape and the adapters read twenty-two
languages of them; a call site does not, and a pattern sweep for one across twenty-two languages is
a false-positive machine. Files it could not judge are COUNTED, because a silent omission is how a
partial answer becomes a wrong one.

🐛 [2026-09-22] (self-measured) A `--grep` flag printed the same query's plain-text hit count beside
the answer, which made the difference vivid. It is gone: the README tells an auditor that this
package runs `git` and this interpreter and nothing else, and that sentence is worth more than a
demonstration. The comparison belongs in a release note, where it costs no promise.
"""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import redact  # noqa: E402
import refs  # noqa: E402
import workspace as ws  # noqa: E402

# Shadowed rather than called at each site: a missed scrub is silent, and this prints repository
# paths and symbol names straight into what becomes an agent's transcript. See redact.emit.
print = redact.emit  # noqa: A001

KNOWN_FLAGS = ()
TAKES_VALUE = ()
TAKES_REST = ()


def main(argv):
    if ws.wants_version(argv):
        print(ws.version_line())
        return 0
    if not argv or ws.wants_help(argv):
        print(__doc__.strip())
        return 0 if argv else 2

    bad = ws.unknown_flags(argv, KNOWN_FLAGS, TAKES_VALUE, TAKES_REST)
    if bad:
        print(f"chamnan-where: unknown flag {bad[0]} — try --help", file=sys.stderr)
        return 2

    symbol = argv[0]
    root = ws.find_root() or Path(os.getcwd())
    hits, unjudged = refs.find(root, symbol)
    if not hits:
        print(f"chamnan: no use of `{symbol}` in any Python file under {Path(root).name}/.")
        if unjudged:
            print(f"  {unjudged} file(s) could not be judged, so this is not a proof of absence.")
        return 0

    by_kind = {}
    for rel, line, kind in hits:
        by_kind.setdefault(kind, []).append(f"{rel}:{line}")
    print(f"chamnan: {len(hits)} use(s) of `{symbol}`")
    for kind in ("def", "call", "attribute"):
        for one in by_kind.get(kind, []):
            print(f"  {kind:9} {one}")
    if unjudged:
        print(f"  ({unjudged} file(s) too large or unparseable — not judged, not absent)")
    return 0


if __name__ == "__main__":
    sys.exit(ws.never_fail(lambda: main(sys.argv[1:])))
