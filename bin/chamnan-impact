#!/usr/bin/env python3
"""chamnan-impact — what breaks if I change this file, and what happened last time it changed.

  chamnan-impact <path>          who depends on it, what tests cover it, what threads name it

The dependency half already existed and already feeds MAP.md; it simply had no way to be ASKED.
The other half is the join this exists for: a thread entry that named this file carries "last time
this changed, it needed a rollback", which is the part no import graph can tell you and the part
that actually changes what someone does next.

**Read from `MAP.md`, not rescanned.** A full scan of the repository this plugin is developed
against measured 64 seconds — not something to do on an interactive question. The cost of that
choice is that the answer is only as fresh as the last `chamnan-map`, so the age of the index is
printed with every answer rather than left for the reader to assume.
"""
import importlib.util
import pathlib
import sys
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import impact as impact_mod  # noqa: E402
import mdblock
import memory  # noqa: E402
import timeline  # noqa: E402
import workspace as ws  # noqa: E402
import redact  # noqa: E402

# Everything this command prints comes out of committed files, and none of it used to go through
# the redactor while the SessionStart hook scrubbed the same stores. Shadowing `print` here rather
# than wrapping each call site: a per-call rule is one every future print has to remember, and the
# misses are silent. See redact.emit.
print = redact.emit  # noqa: A001


def _index_age(map_path, root=None):
    """How old the index is, and -- more importantly -- whether the code has moved since.

    🐛 [2026-09-08] This measured age against the CLOCK and nothing else, so an index built an hour
    ago read "built today" while a file added five minutes ago imported the very symbol being asked
    about. The command then said "nothing imports it", which is not a stale answer but a WRONG one:
    the reader changes the thing freely on the strength of it. Reproduced by adding an importing
    file to a fixture and asking again (R2 agent 4).
    #
    `index_is_behind` already answers this correctly, by comparing the index against the mtimes of
    the files mapper would index, and it lived in the SessionStart hook with exactly one caller --
    the hook itself. It is loaded here the way `chamnan-context` already loads that hook, rather
    than copied: a second implementation of a staleness rule is how the two come to disagree, and
    this file is fixing an instance of precisely that.
    """
    try:
        ts = map_path.stat().st_mtime
    except OSError:
        return "unknown age"
    days = int((datetime.now(timezone.utc).timestamp() - ts) // 86400)
    age = "built today" if days <= 0 else f"built {days} day{'s' if days != 1 else ''} ago"
    if root is None:
        return age
    try:
        spec = importlib.util.spec_from_file_location(
            "chamnan_session_start", HERE.parent / "hooks" / "chamnan_session_start.py")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        behind, edited = module.index_is_behind(root, map_path)
    except Exception:
        # Never fails the command over its own footnote. An answer without the staleness note is
        # worse than one with it and better than no answer at all.
        return age
    if not behind:
        return age + ", current with the code"
    # `edited` is a LIST of names, and interpolating it whole printed `['src/newcomer.py']` at the
    # reader -- a Python repr in a sentence written for a person. One name is enough to make the
    # warning actionable; the count says whether there is more.
    if isinstance(edited, (list, tuple, set)):
        names = sorted(str(e) for e in edited)
        first = names[0] if names else ""
        more = f" and {len(names) - 1} more" if len(names) > 1 else ""
    else:
        first, more = str(edited or ""), ""
    named = f", newest change `{mdblock.as_quoted(first, 60)}`{more}" if first else ""
    return (f"{age} but THE CODE HAS MOVED SINCE{named} — rebuild with `chamnan-map` before "
            f"trusting this")


# 🐛 [2026-09-08] Three of ten commands refused an unknown flag and seven ignored it, running
# their default action with nothing on screen -- so a typo did something other than what was asked
# and said nothing. `ws.unknown_flags` existed the whole time; the seven could not use it because
# it read every VALUE as a flag, which is why it grew `takes_value`/`takes_rest` first. The set,
# not the member this round happened to be pointed at (R7 agent 4).
KNOWN_FLAGS = ()
TAKES_VALUE = ()
TAKES_REST = ()


def main(argv):
    # Before help. These three answer help for a BARE call too, so `--version` has to be
    # tested first or it would print usage instead. See workspace.wants_version.
    if ws.wants_version(argv):
        print(ws.version_line())
        return 0
    if not argv or ws.wants_help(argv):
        print(__doc__.strip())
        return 0 if argv else 2

    _bad = ws.unknown_flags(argv, KNOWN_FLAGS, TAKES_VALUE, TAKES_REST)
    if _bad:
        print(f"chamnan-impact: unknown flag {_bad[0]} — try --help", file=sys.stderr)
        return 2

    root = ws.find_root()
    wsdir = ws.workspace(root)
    if not wsdir.is_dir():
        # 🐛 [2026-09-06] A dead end in six of ten commands. `chamnan-context` was given the way
        # out on 2026-09-05 and its siblings were not, and `chamnan-impact` carried BOTH — this
        # sentence, and the actionable one 46 lines below it for a near-identical condition — so
        # which of the two a user got depended on whether `.chamnan/` happened to exist yet, an
        # ordering accident rather than anything they controlled. No test ran any of the six
        # against a directory that genuinely has no workspace (R15 agent 3).
        print(f"chamnan: no .chamnan/ workspace at {root}. Run `chamnan-map` there first — it "
              f"creates the workspace and builds the index. (Inside Claude Code, "
              f"`/chamnan:bootstrap` does that and records a baseline.)", file=sys.stderr)
        return 1

    # 🐛 The argument went to `impact_mod.lookup()` raw, and lookup keys on repository-relative
    # paths -- so an ABSOLUTE path, which is the canonical form in Claude Code (Read and Edit both
    # require one), matched nothing. This command's entire job is "what breaks if I change this",
    # and for the path form an agent is most likely to be holding it answered
    # "nothing imports it ... change it freely". `chamnan_file_pointer.py` relativises before the
    # same call; this did not.
    target = argv[0]
    _t = pathlib.Path(target)
    if _t.is_absolute():
        try:
            target = _t.resolve().relative_to(pathlib.Path(root).resolve()).as_posix()
        except (OSError, ValueError):
            print(f"chamnan: {mdblock.as_quoted(argv[0], 100)} is outside this repository",
                  file=sys.stderr)
            return 1
    # Existence changes only the WORDING of the all-clear below, never whether the question is
    # answered: a file that was deleted can still have a history worth reading, and the suite pins
    # that. What it must not do is call a path nobody has ever seen "the cheap case".
    on_disk = (pathlib.Path(root) / target).exists()

    map_path = wsdir / "MAP.md"
    edges = None
    resolved = None
    if map_path.is_file():
        text = map_path.read_text(encoding="utf-8-sig", errors="replace")
        resolved, edges = impact_mod.lookup(text, target)
    # 🐛 This returned before the thread join below, so in a repository where chamnan-map has not
    # been run — which is every repository on day one — asking "what happened last time this
    # changed" produced exit 1 and none of the history sitting in .chamnan/threads/. The comment
    # under it already says the join "runs whether or not the index has anything, because the two
    # halves answer different questions". It did not.
    elif ws.enabled("map", root) and not (
            timeline.for_path(root, target) if ws.enabled("timeline", root) else []):
        print(f"chamnan: no index yet — run `chamnan-map` first", file=sys.stderr)
        return 1

    # The thread join runs whether or not the index has anything, because the two halves answer
    # different questions and a file with no dependents can still have been rolled back twice.
    history = timeline.for_path(root, target) if ws.enabled("timeline", root) else []
    # The other half of the same join. `timeline.for_path` answers "what has HAPPENED to this
    # file"; this answers "what was DECIDED about it, what went wrong with it, what rule covers
    # it" -- and nothing asked it before, so this command could name what imports a file and never
    # what the repository had already learned about it. Same join key, same matching rule, one
    # definition in `mdblock.names_the_path` (2026-09-08).
    knowledge = memory.knowledge_for(root, target) if ws.enabled("memory", root) else []

    if resolved is None and not history and not knowledge:
        print(f"chamnan: nothing recorded for {mdblock.as_quoted(target, 100)}")
        if map_path.is_file():
            _age = _index_age(map_path, root)
            print(f"  no incoming references in the index ({_age}), no thread "
                  f"entry names it, and nothing in memory/ declares it on a `Files:` line")
            # 🐛 [2026-09-09] The all-clear printed unconditionally, one line under a warning that
            # the index is behind the code. Reproduced live: the staleness note named five files
            # added since the index was built, and the next line still said "change it freely".
            # The warning is exactly the case where "nothing imports it" is not a stale answer but
            # a WRONG one — the same reasoning `_index_age`'s own docstring gives for existing —
            # and the verdict was not gated on it. A reader who trusts the second line has been
            # told the opposite of what the first line means (R5 agent3, 2026-09-09).
            if on_disk and "the code has moved since" in _age.lower():
                print(f"  the index is behind the code, so this is not an all-clear: a file added "
                      f"since it was built could import this one. Run `chamnan-map`, then ask again")
            # 🐛 [2026-09-13] A current outer index deliberately excludes nested repositories, so
            # absence from that index says nothing about a file the nested repository owns. This
            # is the third unanswered case beside a stale index and a path that is not on disk
            # (R3, R5 triage).
            elif (on_disk and ws.find_root(pathlib.Path(root) / target)
                  != pathlib.Path(root).resolve()):
                print(f"  this file belongs to a repository this index does not cover, so `nothing "
                      f"recorded` is not an answer — ask from inside that repository instead")
            elif on_disk:
                print(f"  a file nothing imports and nothing has happened to is the cheap case — "
                      f"change it freely")
            else:
                # 🐛 A one-character typo used to land here and be told to change it freely. Nothing
                # is recorded about a path the repository does not contain, and that is a question
                # that could not be answered rather than an answer of "no risk".
                print(f"  and there is no such file in this repository, so this is not an "
                      f"all-clear — check the path")
        return 0

    # Every name below comes out of the index, which is built from the repository. This is a
    # terminal, and an agent's Bash output becomes transcript. `print = redact.emit` guards
    # credentials, not control characters -- which read as guarded until it was tested.
    print(f"chamnan-impact — {mdblock.as_quoted(resolved or target, 100)}\n")

    if edges:
        if edges["used_by"]:
            shown = ", ".join(mdblock.as_quoted(_e, 80) for _e in edges["used_by"])
            more = f" (+{edges['used_by_more']} more)" if edges["used_by_more"] else ""
            print(f"  used by   {shown}{more}")
        if edges["tests"]:
            shown = ", ".join(mdblock.as_quoted(_e, 80) for _e in edges["tests"])
            more = f" (+{edges['tests_more']} more)" if edges["tests_more"] else ""
            print(f"  tested by {shown}{more}")
        elif edges["used_by"]:
            print(f"  tested by nothing the index can see — a change here is unguarded")
        print(f"  (from `{map_path.relative_to(root).as_posix()}`, {_index_age(map_path, root)})")
    elif map_path.is_file():
        print(f"  nothing imports it, per `{map_path.relative_to(root).as_posix()}` ({_index_age(map_path, root)})")

    if history:
        print(f"\n  {len(history)} thread entr{'y' if len(history) == 1 else 'ies'} name this file:")
        for path, date, note in history:
            print(f"    {date} — {note}")
            print(f"               on {timeline.title_of(path)}")
        print("\n  `chamnan-timeline show <name>` for the whole thread.")

    if knowledge:
        # Grouped by kind, because the four answer different questions and a flat list reads as one
        # undifferentiated pile: a decision says why it is this way, an incident says what went
        # wrong, a lesson says what not to do again, a rule says what must hold.
        print(f"\n  what this repository already decided about it:")
        _last = None
        for _cat, _path, _title in knowledge:
            if _cat != _last:
                print(f"    {_cat}")
                _last = _cat
            print(f"      {mdblock.as_quoted(_title, 90)}")
            print(f"        {_path.relative_to(root).as_posix()}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
