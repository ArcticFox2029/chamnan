#!/usr/bin/env python3
"""chamnan-candidates — review what the workflow detector has found, quickly.

`notice_workflow()` already writes one file per repeated command sequence under
`.chamnan/candidates/` (see lib/candidates.py) the moment it crosses the detection threshold. This
is the other half: looking at what accumulated, and deciding what to do with each one.

  chamnan-candidates                       list what is waiting (same as `list`)
  chamnan-candidates confirm <id>          mark reviewed and worth keeping (Provenance -> ai-confirmed)
  chamnan-candidates reject <id>           delete it — not a routine worth keeping
  chamnan-candidates edit <id>             print the file's path, to open and adjust by hand
  chamnan-candidates promote <id>          suggest where a CONFIRMED candidate belongs, decide nothing
  chamnan-candidates promote <id> tool <name>   install a script SKELETON in .chamnan/tools/<name>
  chamnan-candidates promote <id> skill         print what to hand to /chamnan:capture
  chamnan-candidates demote <tool-name>         undo a tool promotion — flagged too often, send it back

<id> (for confirm/reject/edit/promote) is either a candidate's position in the list above
(1, 2, 3 — computed fresh each time, not cached from an earlier call) or its slug/filename, with or
without `.md`. `demote` takes a TOOL's name instead — from `.chamnan/tools/`, or from the notice
that suggested it (`chamnan-candidates demote deploy-check.sh`).

**`confirm` does not promote anything into `skills/` or `tools/`.** It only records that a human
looked at the candidate and thinks the routine is real — moving Provenance from `ai-inferred` to
`ai-confirmed`. `promote` requires that step to have already happened; it refuses an unconfirmed
candidate rather than skip a link in evidence -> candidate -> human confirm -> memory.

**Promoting to `tool` never writes real commands, because chamnan does not have them.** A
candidate stores SIGNATURES (`git commit`, not the literal command that ran) — `promote ... tool`
writes a skeleton with each step as a labelled placeholder and registers it in
`.chamnan/tools/index.json` via the same machinery `chamnan-promote` uses, but the file is not
runnable until you fill in the real commands. **Promoting to `skill` writes nothing at all** — a
good skill needs prose explaining WHY, which this tool cannot honestly generate from a signature
list, so it prints the sequence as a starting point and tells you to run `/chamnan:capture`
yourself.
"""
import stat
import sys
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import candidates  # noqa: E402
import tools_index  # noqa: E402
import workspace as ws  # noqa: E402
import redact  # noqa: E402

# Every `bin/` command shadows print with the scrubbing emitter, whether or not its output looks
# like it could carry a secret today. Five findings running came from one store having a guarded
# reader and an unguarded one, and the case-by-case judgement about which commands "only print
# numbers" is exactly the judgement that was wrong each time. Uniform is cheaper to keep true than
# correct-per-file. See redact.emit.
print = redact.emit  # noqa: A001

# A candidate must have passed through `confirm` (or been written by a human in the first place)
# before `promote` will touch it -- the pipeline is evidence -> candidate -> human confirm ->
# memory, and skipping the confirm step here would skip a link in it, not just a formality.
CONFIRMED_PROVENANCE = ("ai-confirmed", "user")


def _title(path):
    text = path.read_text(encoding="utf-8", errors="replace")
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return path.stem


def cmd_list(root):
    found = candidates.entries(root)
    if not found:
        print("chamnan: no candidates waiting for review")
        return 0
    print(f"{len(found)} candidate(s) waiting\n")
    for i, p in enumerate(found, 1):
        f = candidates.fields_of(p)
        print(f"[{i}] {_title(p)}")
        print(f"    observed {f.get('observed', '?')} time(s) · last seen {f.get('last seen', '?')} "
              f"· {f.get('provenance', '?')}")
    print("\nconfirm/reject/edit by number or by name — see `chamnan-candidates --help`")
    return 0


def _find_or_complain(root, ident):
    p = candidates.resolve(root, ident)
    if p is None:
        print(f"chamnan: no candidate matches {ident!r} — run `chamnan-candidates` to list them",
              file=sys.stderr)
    return p


def cmd_confirm(root, ident):
    p = _find_or_complain(root, ident)
    if p is None:
        return 1
    candidates.set_provenance(p, "ai-confirmed")
    print(f"chamnan: confirmed — {_title(p)}")
    print(f"  Provenance -> ai-confirmed. To keep it, run:")
    print(f"    chamnan-promote <script-file> <name>   (a tool)")
    print(f"    /chamnan:capture                        (a written-out procedure)")
    return 0


def cmd_reject(root, ident):
    p = _find_or_complain(root, ident)
    if p is None:
        return 1
    title = _title(p)
    p.unlink()
    print(f"chamnan: rejected and removed — {title}")
    return 0


def cmd_edit(root, ident):
    p = _find_or_complain(root, ident)
    if p is None:
        return 1
    print(p.relative_to(root))
    return 0


def _sequence_of(fields):
    return [s.strip() for s in fields.get("sequence", "").split(",") if s.strip()]


def cmd_promote(root, ident, destination=None, name=None):
    p = _find_or_complain(root, ident)
    if p is None:
        return 1
    fields = candidates.fields_of(p)
    title = _title(p)
    sequence = _sequence_of(fields)

    if fields.get("provenance") not in CONFIRMED_PROVENANCE:
        print(f"chamnan: {title!r} has not been confirmed yet — run "
              f"`chamnan-candidates confirm {ident}` first", file=sys.stderr)
        return 1

    if destination is None:
        # No real signal exists to choose confidently from a signature list alone -- a candidate
        # stores WHAT ran, never why, so this is a stated default with an honest caveat, never a
        # score dressed up as a decision. See PLAN.md's standing rejection of invented Health/
        # Confidence scores; the same objection applies here.
        print(f"chamnan: {title}")
        print("  Suggested: tool — this is a sequence of shell commands, which is what a tool is.")
        print("  Choose skill instead if the real value is explaining WHY, or a judgement call at")
        print("  one of the steps — chamnan cannot tell that from the sequence alone; you can.")
        print(f"\n  chamnan-candidates promote {ident} tool <name>")
        print(f"  chamnan-candidates promote {ident} skill")
        return 0

    if destination == "tool":
        if not name:
            print("chamnan: promote ... tool needs a name — chamnan-candidates promote <id> tool <name>",
                  file=sys.stderr)
            return 2
        safe = ws.safe_tool_name(name)
        if safe is None:
            print(f"chamnan: {name!r} is not a usable tool name — it has to be a plain filename,\n"
                  "  no directory separators, and no leading dot or dash. The registry stores the bare\n"
                  "  name, so a path here would leave an entry pointing at a file nothing can find.",
                  file=sys.stderr)
            return 2
        try:
            tools = ws.ensure(root) / "tools"
        except ws.NotAWorkspace as err:
            print(f"chamnan: {err}", file=sys.stderr)
            return 1
        dest = tools / (safe if Path(safe).suffix else safe + ".sh")
        if dest.exists():
            print(f"chamnan: {dest.name} already exists — pick another name or edit it in place",
                  file=sys.stderr)
            return 1
        lines = ["#!/bin/bash",
                 f"# {dest.stem} — generated from a confirmed candidate, not a real script yet.",
                 f"# Detected sequence (observed {fields.get('observed', '?')} time(s)): "
                 f"{', '.join(sequence)}",
                 "# Replace every placeholder below with the ACTUAL command you run at that step.",
                 "set -euo pipefail", ""]
        for i, step in enumerate(sequence, 1):
            lines.append(f'echo "TODO step {i}: {step}" >&2; exit 1  # replace this line')
        dest.write_text("\n".join(lines) + "\n", encoding="utf-8")
        dest.chmod(dest.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
        tools_index.register(root, {
            "name": dest.name,
            "desc": f"from a confirmed candidate: {title} — placeholders, not filled in yet",
            "added": datetime.now().astimezone().isoformat(timespec="seconds"),
            "origin": f"candidate:{p.stem}",
        })
        p.unlink()
        rel = dest.relative_to(root)
        print(f"chamnan: skeleton installed -> {rel}")
        print(f"  it will exit non-zero until you replace the TODO lines with real commands")
        print(f"  the candidate is removed — its finding now lives in {rel}")
        return 0

    if destination == "skill":
        print(f"chamnan: {title} — hand this to /chamnan:capture:")
        print(f"  Sequence: {', '.join(sequence)}")
        print(f"  Observed {fields.get('observed', '?')} time(s), last seen "
              f"{fields.get('last seen', '?')}")
        print("  Nothing is written here — capture needs the reasoning only you have.")
        return 0

    print(f"chamnan: unknown destination {destination!r} — tool or skill", file=sys.stderr)
    return 2


def cmd_demote(root, tool_name):
    """Undo a tool promotion: remove it from tools/index.json, delete the file, and write a new
    candidate so the routine goes through review again rather than disappearing outright. The new
    candidate's "sequence" is the tool's own description, not a reconstruction of the original
    detected steps — precise replay is not recoverable from what the index stores, and a record
    that reminds a reviewer what the tool was for is more honest than pretending otherwise."""
    entry = tools_index.remove(root, tool_name)
    if entry is None:
        print(f"chamnan: no promoted tool named {tool_name!r} — see `chamnan-promote --list`",
              file=sys.stderr)
        return 1
    # 🐛 Deleted the file. A promoted tool ships as a SKELETON with each step as a placeholder --
    # the docs above say so -- so every tool that is actually useful has hand-written commands in
    # it, and "undo a promotion" destroyed them with no copy anywhere. The candidate written below
    # is explicitly not a reconstruction: it carries one line of description. Un-register it,
    # archive the file, and say where it went.
    tool_path = ws.workspace(root) / "tools" / tool_name
    archived = None
    if tool_path.is_file():
        archive_dir = ws.workspace(root) / "tools" / "archived"
        try:
            archive_dir.mkdir(parents=True, exist_ok=True)
            dest = archive_dir / tool_name
            if dest.exists():
                stamp = datetime.now().astimezone().strftime("%Y%m%d-%H%M%S")
                dest = archive_dir / f"{tool_name}.{stamp}"
            tool_path.replace(dest)
            archived = dest
        except OSError:
            # Better to leave the file where it is than to lose it because the archive failed.
            archived = tool_path
    sequence = [entry.get("desc") or tool_name]
    today = datetime.now().astimezone().strftime("%Y-%m-%d")
    new_path, _is_new = candidates.upsert(root, sequence, 1, today, provenance="ai-inferred")
    print(f"chamnan: demoted {tool_name} — removed as a tool, back for review at "
          f"{new_path.relative_to(root)}")
    if archived:
        print(f"  the file itself is kept at {archived.relative_to(root)} — the candidate above is "
              f"one line of description, not the commands you wrote")
    return 0


def main(argv):
    root = ws.find_root()
    wsdir = ws.workspace(root)
    if not wsdir.is_dir():
        print("chamnan: no .chamnan workspace here", file=sys.stderr)
        return 1
    if not ws.enabled("promote", root):
        print("chamnan: promote is disabled in .chamnan/config.json — candidates are part of it")
        return 0

    if not argv or argv[0] in ("list", "-l", "--list"):
        return cmd_list(root)
    if argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    cmd, *rest = argv
    if cmd not in ("confirm", "reject", "edit", "promote", "demote"):
        print(f"chamnan: unknown command {cmd!r} — list, confirm <id>, reject <id>, edit <id>, "
              f"promote <id> [tool|skill], demote <tool-name>", file=sys.stderr)
        return 2
    if not rest:
        if cmd == "demote":
            print("chamnan: demote needs a tool name — see `chamnan-promote --list`",
                  file=sys.stderr)
        else:
            print(f"chamnan: {cmd} needs a candidate — number or name from `chamnan-candidates`",
                  file=sys.stderr)
        return 2

    if cmd == "demote":
        return cmd_demote(root, rest[0])

    if cmd == "promote":
        ident, *pdest = rest
        destination = pdest[0] if pdest else None
        name = pdest[1] if len(pdest) > 1 else None
        return cmd_promote(root, ident, destination, name)

    return {"confirm": cmd_confirm, "reject": cmd_reject, "edit": cmd_edit}[cmd](root, rest[0])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
