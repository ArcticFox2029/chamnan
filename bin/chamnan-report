#!/usr/bin/env python3
"""chamnan-report — measure this repo's context cost per turn, before and after the workspace existed.

Claude Code already writes every request's token usage to ~/.claude/projects/<encoded-cwd>/. This
reads that, groups by week, and marks the week the workspace was created, so the user sees the effect
on their OWN repository instead of taking a number from someone's README on faith.

Three details decide whether the figures are right, each learned the hard way (2026-08-19):

  1. READ EVERY TRANSCRIPT. Subagent runs live in <session>/subagents/ and workflow runs in
     <session>/wf_*/. A one-level glob missed 112 of 138 files and 3,203 requestIds here.
  2. DEDUP BY requestId, KEEPING THE FULLEST RECORD. A streamed response is rewritten as it grows
     and its usage block is cumulative, so the same id appears many times; the LAST is complete.
     Keeping the first silently under-counts, skipping dedup roughly doubles everything.
  3. CONTEXT PER CALL IS THE METRIC, NOT COST. Cost moves when the user changes model, which has
     nothing to do with this tool. Tokens carried per turn is what a workspace can actually change.
"""
import json
import re
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import ledger  # noqa: E402
import tools_index  # noqa: E402
import workflows  # noqa: E402
import workspace as ws  # noqa: E402

PROJECT_ROOT = Path.home() / ".claude" / "projects"
SNAPSHOT = re.compile(r"-\d{8}$")


def encoded_dir(repo_root):
    """Claude Code encodes the working directory by replacing separators with dashes.

    The encoding is lossy — a directory whose own name contains a dash is indistinguishable from a
    separator — so an exact match is tried first and a suffix match is the fallback."""
    want = str(repo_root).replace("/", "-")
    exact = PROJECT_ROOT / want
    if exact.is_dir():
        return exact
    # The fallback used to accept any directory whose name ended with this repo's basename, and
    # return the first in sort order. `~/work/Lumin-App` and `~/Documents/Lumin-App` both end that
    # way, so a checkout of the same project elsewhere -- or an unrelated repo that happens to
    # share a basename -- had its token spend reported as this one's, with nothing on screen
    # saying which had been read. Rank by how much of the path actually agrees, and when two
    # candidates agree equally there is no honest answer: say nothing rather than guess.
    best, best_score, tied = None, 0, False
    for cand in sorted(PROJECT_ROOT.glob("*")):
        if not cand.is_dir():
            continue
        score = _shared_tail(want, cand.name)
        if score > best_score:
            best, best_score, tied = cand, score, False
        elif score and score == best_score:
            tied = True
    return None if tied else best


def _shared_tail(want, have):
    """How many trailing encoded components the two names agree on, anchored on the dash so `-app`
    is not counted as a match for `-my-app`. Both sides are split the same lossy way, so the
    comparison stays consistent even where a directory name contains its own dash."""
    a, b = want.split("-"), have.split("-")
    n = 0
    while n < len(a) and n < len(b) and a[-1 - n] == b[-1 - n]:
        n += 1
    return n


def collect(project_dir):
    best = {}
    for path in project_dir.rglob("*.jsonl"):
        try:
            fh = path.open(errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                msg = rec.get("message") or {}
                usage, rid, model = msg.get("usage"), rec.get("requestId"), msg.get("model")
                ts = rec.get("timestamp")
                if not (isinstance(usage, dict) and rid and model and ts):
                    continue
                try:
                    when = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
                except ValueError:
                    continue
                entry = (
                    when, SNAPSHOT.sub("", model),
                    usage.get("input_tokens") or 0, usage.get("output_tokens") or 0,
                    usage.get("cache_read_input_tokens") or 0,
                    usage.get("cache_creation_input_tokens") or 0,
                )
                prior = best.get(rid)
                if prior is None or sum(entry[2:]) > sum(prior[2:]):
                    best[rid] = entry
    return list(best.values())


def print_inventory(root):
    """What actually exists in this workspace: store / entries / last written, zeros printed
    plainly, plus the two heuristic checks that gauge whether what is written here is really about
    THIS repository. This is the visibility half of the ledger's own finding -- Stage 1's line is
    budget-constrained to one sentence at SessionStart; this is the same numbers, read on demand,
    with room to say more.
    """
    rows = ledger.inventory(root)
    print("Knowledge inventory")
    width = max(len(label) for label, _, _ in rows)
    for label, count, last_ts in rows:
        noun = "entry" if count == 1 else "entries"
        print(f"  {label:<{width}}   {count:>3} {noun:<8}   last write {ledger.humanize_age(last_ts)}")

    naming_none, lessons_total = ledger.entries_naming_no_file(root, "lessons")
    if lessons_total:
        print(f"\n  {naming_none} of {lessons_total} lessons name no file in this repository")

    without, decisions_total = ledger.decisions_without_rejected(root)
    if decisions_total:
        plural = "decision has" if without == 1 else "decisions have"
        print(f"  {without} of {decisions_total} {plural} no `Rejected:` — a trade-off nobody wrote down")
    print()


def known_commands():
    """Every `chamnan-*` script in `bin/` alongside this one, sorted. Read from the directory
    rather than a hand-kept list, so a new CLI command is picked up here the day it is added,
    with nothing else to update."""
    return sorted(p.name for p in HERE.iterdir() if p.is_file() and p.name.startswith("chamnan-"))


def print_usage(root):
    """Counts, never a savings figure — a tokens-saved number would be invented, and this project
    already retired an "Engineer Scoreboard" for measuring what is easy instead of what matters.
    Two sources, both already being written before this function existed to read them: chamnan's
    own commands come from `commands.jsonl`'s signatures (the same log the workflow detector
    already keeps), and promoted tools come from `tools/index.json`'s `runs` counter (incremented
    by every matched Bash call since Stage 10).
    """
    log = ws.workspace(root) / "logs" / "commands.jsonl"
    counts, oldest, newest = workflows.usage_counts(log, known_commands())
    print("Usage")
    width = max(len(name) for name in counts)
    for name in sorted(counts):
        n = counts[name]
        print(f"  {name:<{width}}   {n:>3} time{'s' if n != 1 else ''}")
    if oldest and newest:
        print(f"  (from the calls currently logged, {oldest[:10]} to {newest[:10]} — "
              f"commands.jsonl keeps {workflows.KEEP_DAYS} days; chamnan's own commands are never "
              f"evicted, so these counts are exact for that window)")
    else:
        print("  (nothing logged yet)")

    tools = tools_index.usage(root)
    if tools:
        print("\nPromoted tools")
        twidth = max(len(name) for name, _ in tools)
        for name, runs in tools:
            print(f"  {name:<{twidth}}   {runs:>3} run{'s' if runs != 1 else ''}")
    print()


def print_pointer(root, project_dir):
    """Did the session open what it was pointed at?

    The measurement `hooks/chamnan_file_pointer.py` was built to allow, and it is deliberately NOT "how
    often did it match". A pointer that fires on 39 of 42 files and names the wrong entry scores
    identically to one that names the right entry, so a match rate measures the pointer's
    enthusiasm, not its usefulness. What can be checked is whether the thing it named was then
    opened — and both halves of that are already written down: logs/pointer.jsonl records what was
    named, and Claude Code's own transcripts record every file the session read.

    Still an observation, not proof. A session may act on knowledge without opening the file, and a
    file may be opened for an unrelated reason. Reported as a count, never as a score.
    """
    log = ws.workspace(root) / "logs" / "pointer.jsonl"
    if not log.is_file():
        return
    fired, named = 0, {}
    try:
        for line in log.read_text(encoding="utf-8").splitlines():
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            fired += 1
            for path in rec.get("named") or []:
                named.setdefault(path, set()).add(rec.get("session"))
    except OSError:
        return
    if not fired:
        return

    # Every path this repo's sessions have READ, from the transcripts rather than from a new log.
    opened = set()
    for f in project_dir.rglob("*.jsonl"):
        try:
            with f.open(encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    if '"tool_use"' not in line or ".chamnan" not in line:
                        continue          # cheap prefilter; these files run to hundreds of MB
                    try:
                        d = json.loads(line)
                    except ValueError:
                        continue
                    content = (d.get("message") or {}).get("content")
                    if not isinstance(content, list):
                        continue
                    for b in content:
                        if isinstance(b, dict) and b.get("type") == "tool_use":
                            fp = (b.get("input") or {}).get("file_path") or ""
                            if ".chamnan" in fp:
                                opened.add(fp.split(".chamnan/")[-1])
        except OSError:
            continue

    followed = sorted(p for p in named if p in opened)
    print("Pointer — knowledge named when a file was opened")
    print(f"  fired                {fired:>4} time(s), naming {len(named)} distinct entr(ies)")
    print(f"  later opened         {len(followed):>4} of those {len(named)}")
    for path in followed[:6]:
        print(f"      {path}")
    if len(followed) > 6:
        print(f"      …and {len(followed) - 6} more")
    print("  (an observation, not a score: knowledge can be acted on without the file being")
    print("   opened, and a file can be opened for a reason that has nothing to do with this)")
    print()


def main(argv):
    root = ws.find_root()
    if not ws.enabled("report", root):
        print("chamnan: report is disabled in .chamnan/config.json")
        return 0
    print_inventory(root)
    print_usage(root)
    project_dir = encoded_dir(root)
    if project_dir:
        print_pointer(root, project_dir)
    if not project_dir:
        # 🐛 [2026-08-28] Returned 1. A repository nobody has worked on in Claude Code yet has no
        # transcripts, which is the ordinary state on the day the plugin is installed — not a
        # failure, and the inventory above was printed in full regardless. Reporting it as an error
        # made the very first `chamnan-report` a new user runs look broken. Same for the case
        # below: transcripts exist but hold nothing yet.
        print(f"chamnan: no Claude Code transcripts found for {root}")
        print("  (nothing to measure until this repo has been worked on in Claude Code)")
        return 0
    ws.prune_logs(root)
    ws.prune_sessions(root)
    entries = collect(project_dir)
    if not entries:
        print("chamnan: transcripts found but no usage records yet")
        return 0

    marker = None
    wsdir = ws.workspace(root)
    if wsdir.exists():
        marker = datetime.fromtimestamp(wsdir.stat().st_ctime).astimezone()

    weeks = defaultdict(lambda: {"calls": 0, "cread": 0, "cwrite": 0, "out": 0})
    per_model = defaultdict(lambda: {"calls": 0, "cread": 0})
    for when, model, inp, out, cread, cwrite in entries:
        key = when.isocalendar()[:2]
        w = weeks[key]
        # `inp` is input the model read that was NOT served from cache -- the whole prompt on a
        # cache miss, which is every session's first call and every call after the cache expires.
        # It was unpacked here and then dropped, so those calls reported a context of zero and
        # dragged the per-call average down by exactly the calls that cost the most.
        w["calls"] += 1; w["cread"] += cread + inp; w["cwrite"] += cwrite; w["out"] += out
        pm = per_model[model]
        pm["calls"] += 1; pm["cread"] += cread + inp

    print(f"chamnan-report — {root.name}   ({len(entries):,} calls across {len(weeks)} week(s))\n")
    print(f"  {'week':<10}{'calls':>8}{'context/call':>15}{'new-read/call':>16}{'out/call':>11}")
    marker_week = marker.isocalendar()[:2] if marker else None
    for key in sorted(weeks):
        w = weeks[key]
        c = max(w["calls"], 1)
        tag = "  <- .chamnan created" if key == marker_week else ""
        print(f"  {key[0]}-w{key[1]:<5}{w['calls']:>8,}{w['cread']/c:>15,.0f}{w['cwrite']/c:>16,.0f}{w['out']/c:>11,.0f}{tag}")

    if marker_week and any(k < marker_week for k in weeks) and any(k > marker_week for k in weeks):
        def side(pred):
            calls = cread = cwrite = 0
            for key, w in weeks.items():
                if pred(key):
                    calls += w["calls"]; cread += w["cread"]; cwrite += w["cwrite"]
            return calls, cread / max(calls, 1), cwrite / max(calls, 1)
        bc, bcr, bcw = side(lambda k: k < marker_week)
        ac, acr, acw = side(lambda k: k > marker_week)
        print(f"\n  before  {bc:>7,} calls   context/call {bcr:>10,.0f}   new-read/call {bcw:>9,.0f}")
        print(f"  after   {ac:>7,} calls   context/call {acr:>10,.0f}   new-read/call {acw:>9,.0f}")
        print(f"  change  {'':>7}          {(acr-bcr)/max(bcr,1)*100:>+21.1f}%{(acw-bcw)/max(bcw,1)*100:>+22.1f}%")
        print("\n  Read this as an observation, not an experiment: your model, your task mix and")
        print("  Claude Code itself all changed over the same period. It is your repo's number,")
        print("  which is the point — but it is not a controlled trial.")
    else:
        print("\n  Not enough history on both sides of the workspace's creation date to compare yet.")
        print("  Run this again after a week or two of normal work.")

    lang = ws.load_config(root).get("language", "en")
    if lang == "en":
        print("\n  Tip: chamnan writes generated comments and recorded procedures in English by")
        print("  default — they are re-read every session, and English carries the same meaning in")
        print("  fewer tokens. Set \"language\" in .chamnan/config.json if your team needs another.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
