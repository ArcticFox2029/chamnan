#!/usr/bin/env python3
"""chamnan report — measure this repo's context cost per turn, before and after the workspace existed.

Claude Code already writes every request's token usage to ~/.claude/projects/<encoded-cwd>/. This
reads that, groups by week, and marks the week the workspace was created, so the user sees the effect
on their OWN repository instead of taking a number from someone's README on faith.

Three details decide whether the figures are right, each learned the hard way (2026-08-19):

  1. READ EVERY TRANSCRIPT. Subagent runs live in <session>/subagents/ and workflow runs in
     <session>/wf_*/. A one-level glob missed 112 of 138 files and 3,203 requestIds here.
  2. DEDUP BY requestId, KEEPING THE FULLEST RECORD. A streamed response is rewritten as it grows
     and its usage block is cumulative, so the same id appears many times; the LAST is complete.
     Keeping the first silently under-counts, skipping dedup roughly doubles everything.
  3. CONTEXT PER CALL IS THE METRIC, NOT COST. Cost moves when the user changes model, which has
     nothing to do with this tool. Tokens carried per turn is what a workspace can actually change.
"""
import json
import re
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
import ledger  # noqa: E402
import workspace as ws  # noqa: E402

PROJECT_ROOT = Path.home() / ".claude" / "projects"
SNAPSHOT = re.compile(r"-\d{8}$")


def encoded_dir(repo_root):
    """Claude Code encodes the working directory by replacing separators with dashes.

    The encoding is lossy — a directory whose own name contains a dash is indistinguishable from a
    separator — so an exact match is tried first and a suffix match is the fallback."""
    want = str(repo_root).replace("/", "-")
    exact = PROJECT_ROOT / want
    if exact.is_dir():
        return exact
    tail = repo_root.name
    for cand in sorted(PROJECT_ROOT.glob("*")):
        if cand.is_dir() and cand.name.endswith(tail):
            return cand
    return None


def collect(project_dir):
    best = {}
    for path in project_dir.rglob("*.jsonl"):
        try:
            fh = path.open(errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except json.JSONDecodeError:
                    continue
                msg = rec.get("message") or {}
                usage, rid, model = msg.get("usage"), rec.get("requestId"), msg.get("model")
                ts = rec.get("timestamp")
                if not (isinstance(usage, dict) and rid and model and ts):
                    continue
                try:
                    when = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
                except ValueError:
                    continue
                entry = (
                    when, SNAPSHOT.sub("", model),
                    usage.get("input_tokens") or 0, usage.get("output_tokens") or 0,
                    usage.get("cache_read_input_tokens") or 0,
                    usage.get("cache_creation_input_tokens") or 0,
                )
                prior = best.get(rid)
                if prior is None or sum(entry[2:]) > sum(prior[2:]):
                    best[rid] = entry
    return list(best.values())


def print_inventory(root):
    """What actually exists in this workspace: store / entries / last written, zeros printed
    plainly, plus the two heuristic checks that gauge whether what is written here is really about
    THIS repository. This is the visibility half of the ledger's own finding -- Stage 1's line is
    budget-constrained to one sentence at SessionStart; this is the same numbers, read on demand,
    with room to say more.
    """
    rows = ledger.inventory(root)
    print("Knowledge inventory")
    width = max(len(label) for label, _, _ in rows)
    for label, count, last_ts in rows:
        noun = "entry" if count == 1 else "entries"
        print(f"  {label:<{width}}   {count:>3} {noun:<8}   last write {ledger.humanize_age(last_ts)}")

    naming_none, lessons_total = ledger.entries_naming_no_file(root, "lessons")
    if lessons_total:
        print(f"\n  {naming_none} of {lessons_total} lessons name no file in this repository")

    without, decisions_total = ledger.decisions_without_rejected(root)
    if decisions_total:
        plural = "decision has" if without == 1 else "decisions have"
        print(f"  {without} of {decisions_total} {plural} no `Rejected:` — a trade-off nobody wrote down")
    print()


def main(argv):
    root = ws.find_root()
    if not ws.enabled("report", root):
        print("chamnan: report is disabled in .chamnan/config.json")
        return 0
    print_inventory(root)
    project_dir = encoded_dir(root)
    if not project_dir:
        print(f"chamnan: no Claude Code transcripts found for {root}", file=sys.stderr)
        print("  (nothing to measure until this repo has been worked on in Claude Code)")
        return 1
    ws.prune_logs(root)
    ws.prune_sessions(root)
    entries = collect(project_dir)
    if not entries:
        print("chamnan: transcripts found but no usage records yet", file=sys.stderr)
        return 1

    marker = None
    wsdir = ws.workspace(root)
    if wsdir.exists():
        marker = datetime.fromtimestamp(wsdir.stat().st_ctime).astimezone()

    weeks = defaultdict(lambda: {"calls": 0, "cread": 0, "cwrite": 0, "out": 0})
    per_model = defaultdict(lambda: {"calls": 0, "cread": 0})
    for when, model, inp, out, cread, cwrite in entries:
        key = when.isocalendar()[:2]
        w = weeks[key]
        w["calls"] += 1; w["cread"] += cread; w["cwrite"] += cwrite; w["out"] += out
        pm = per_model[model]
        pm["calls"] += 1; pm["cread"] += cread

    print(f"chamnan report — {root.name}   ({len(entries):,} calls across {len(weeks)} week(s))\n")
    print(f"  {'week':<10}{'calls':>8}{'context/call':>15}{'new-read/call':>16}{'out/call':>11}")
    marker_week = marker.isocalendar()[:2] if marker else None
    for key in sorted(weeks):
        w = weeks[key]
        c = max(w["calls"], 1)
        tag = "  <- .chamnan created" if key == marker_week else ""
        print(f"  {key[0]}-w{key[1]:<5}{w['calls']:>8,}{w['cread']/c:>15,.0f}{w['cwrite']/c:>16,.0f}{w['out']/c:>11,.0f}{tag}")

    if marker_week and any(k < marker_week for k in weeks) and any(k > marker_week for k in weeks):
        def side(pred):
            calls = cread = cwrite = 0
            for key, w in weeks.items():
                if pred(key):
                    calls += w["calls"]; cread += w["cread"]; cwrite += w["cwrite"]
            return calls, cread / max(calls, 1), cwrite / max(calls, 1)
        bc, bcr, bcw = side(lambda k: k < marker_week)
        ac, acr, acw = side(lambda k: k > marker_week)
        print(f"\n  before  {bc:>7,} calls   context/call {bcr:>10,.0f}   new-read/call {bcw:>9,.0f}")
        print(f"  after   {ac:>7,} calls   context/call {acr:>10,.0f}   new-read/call {acw:>9,.0f}")
        print(f"  change  {'':>7}          {(acr-bcr)/max(bcr,1)*100:>+21.1f}%{(acw-bcw)/max(bcw,1)*100:>+22.1f}%")
        print("\n  Read this as an observation, not an experiment: your model, your task mix and")
        print("  Claude Code itself all changed over the same period. It is your repo's number,")
        print("  which is the point — but it is not a controlled trial.")
    else:
        print("\n  Not enough history on both sides of the workspace's creation date to compare yet.")
        print("  Run this again after a week or two of normal work.")

    lang = ws.load_config(root).get("language", "en")
    if lang == "en":
        print("\n  Tip: chamnan writes generated comments and recorded procedures in English by")
        print("  default — they are re-read every session, and English carries the same meaning in")
        print("  fewer tokens. Set \"language\" in .chamnan/config.json if your team needs another.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
